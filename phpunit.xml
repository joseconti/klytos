<?xml version="1.0" encoding="UTF-8"?>
<!--
    Klytos CMS — PHPUnit configuration (Sprint 1, slice 1 / T-01).

    Two tiers, deliberately separated:

      unit         no App, no installation. Storage, managers and hooks are
                   driven against a per-test temporary directory. Runs on a
                   bare checkout.
      integration  boots the real App against the seeded playground and
                   assigns $_SESSION to simulate a role. This is the seam the
                   authorization slices (3, 4, 5) assert their refusals through.
                   Skips itself, loudly, when the playground is not seeded.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true">

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <!--
        failOnWarning is ON as of Sprint 4 slice 1, which is the trigger this
        comment used to name. It was off because NEW-03 (Hooks::doAction() copied
        its arguments, so by-reference listeners never bound) made every page
        creation emit a PHP warning — a live production bug deferred by D-026,
        not test noise to be silenced here.

        Now that the contract is enforced at registration rather than warned
        about at dispatch, a PHP warning in this suite is once again a signal
        rather than a known-and-ignored constant. Keeping it off after the fix
        would have quietly discarded the very evidence that proved the fix:
        the warning's ABSENCE is the user-facing outcome.
    -->

    <!--
        installer/vendor-ai/ is a SIBLING of installer/core/, not nested under
        it, so it needs no exclude here — it was never in the included set.
    -->
    <source>
        <include>
            <directory>installer/core</directory>
        </include>
    </source>
</phpunit>
