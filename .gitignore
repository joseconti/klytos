# ─── Klytos Runtime Data (NEVER commit) ──────────────────────
# These are generated at install time and contain encrypted secrets.
#
# DEFAULT-DENY, added in Sprint 1 slice 8. Everything below this pair of rules
# was — and still is — enumerated file by file, which is an allow-list for
# COMMITTING: a runtime file nobody anticipated defaults to committable. That
# is exactly how `installer/config/update_cache.json.enc` turned up untracked
# and stageable during this slice, and the next such file would too. The only
# tracked files in these two directories are the `.htaccess` access guards
# (verified: `git ls-files installer/config installer/data` lists those two and
# nothing else), so the directories are ignored wholesale and the guards are
# re-included. The specific rules below are kept deliberately: they document
# WHICH secrets live here, and they keep protecting anyone whose clone predates
# this change.
installer/config/*
!installer/config/.htaccess
installer/data/*
!installer/data/.htaccess

installer/config/.encryption_key
installer/config/config.json.enc
installer/config/database.json.enc
installer/config/license.json.enc
installer/config/plugin_licenses/
installer/config/.install.lock
# The admin identity key pair. The .priv.enc file holds the site's RSA PRIVATE
# key — the highest-value secret in the system. It was NOT excluded before, so
# any local install could have staged it. Added with the Sprint 1 playground,
# which generates exactly these files.
installer/config/admin-identity.pub.enc
installer/config/admin-identity.priv.enc
# Playground access details written by scripts/dev/seed-playground.php.
installer/config/.playground-access

# ─── Encrypted Data (user content) ───────────────────────────
installer/data/*.json.enc
installer/data/**/*.json.enc
# Records are only written as *.json.enc when the configured encryption level
# covers that collection; at lower levels the SAME data lands as plain *.json.
# The patterns above therefore did not cover it. Exclude both forms.
installer/data/*.json
installer/data/**/*.json
installer/data/rate_limits.json
# The logs directory name is RANDOMISED per install (config 'logs_dir_name',
# e.g. data/logs-d8950d4907c6), so the fixed 'logs/' pattern never matched a
# real install. Cover both.
installer/data/logs/
installer/data/logs-*/
installer/data/_cache/
installer/data/.transaction.lock
installer/data/.cron.lock

# ─── Backups ─────────────────────────────────────────────────
installer/backups/*.zip
installer/backups/*.tar.gz

# ─── Generated Static Site ───────────────────────────────────
# The public site is generated by the build engine.
installer/public/index.html
installer/public/**/*.html
installer/public/css/style.css
installer/public/sitemap.xml
installer/public/robots.txt
installer/public/llms.txt
installer/public/llms-full.txt

# ─── Uploaded Assets (user content) ──────────────────────────
installer/public/assets/images/
installer/public/assets/uploads/

# ─── Plugin Data ─────────────────────────────────────────────
# Third-party plugins should not be committed.
# Core-bundled plugins can be tracked selectively.
installer/plugins/*/
!installer/plugins/.htaccess
!installer/plugins/hello-ai/
!installer/plugins/klytos-forms/
!installer/plugins/klytos-importer/
!installer/plugins/klytos-x402-coinbase/
!installer/plugins/klytos-x402-stripe/

# ─── Install file (renamed after install) ────────────────────
installer/.install.done.php

# ─── PHP Dependencies ────────────────────────────────────────
# Only exclude root-level vendor/ (Composer). Admin vendor assets are tracked.
/vendor/
# composer.lock IS tracked (D-022): the whole point of the dev manifest is that
# a contributor and CI resolve the SAME PHPUnit/PHPCS versions the author ran.
# It is kept out of the distributable with export-ignore, not with .gitignore.
# The old blanket `composer.lock` rule also hid the vendored ones, so they stay
# ignored explicitly — removing that line must not change what vendor-ai/ tracks.
# Slice 2 (H-04) revisited this and kept it: those nested locks are each package's
# own dev lock, not a record of what Klytos vendors. The real record is
# installer/composer.lock, which IS tracked (D-028), so nothing is lost by
# ignoring them. Note the pattern is `**/` — it does not match installer/composer.lock.
installer/vendor-ai/**/composer.lock

# ─── Test tooling caches ─────────────────────────────────────
.phpunit.cache/
.phpunit.result.cache

# ─── Node.js (dev tooling only — Klytos ships no Node dependency) ─
node_modules/
yarn.lock
# package-lock.json IS tracked, on D-027's reasoning applied to the browser
# driver: an unpinned driver means "the E2E suite passed" denotes something
# different on every machine and every day.

# ─── Browser-driven tier artifacts (traces, video, screenshots, reports) ─
# Keel v5.1.0 records every browser run; the recordings themselves are large,
# regenerated on every run, and never committed. The trace PATH goes in the
# test-point row — `npx playwright show-trace <path>` opens it.
tests/E2E/artifacts/
# Playwright's default output directory, in case a run is ever started
# without the project config picking up outputDir.
test-results/
playwright-report/

# ─── Logs ─────────────────────────────────────────────────────
*.log
logs/

