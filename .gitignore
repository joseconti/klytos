# ─── OS Generated Files ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE / Editor Files ──────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.buildpath
*.sublime-project
*.sublime-workspace
nbproject/

# ─── Klytos Runtime Data (NEVER commit) ──────────────────────
# These are generated at install time and contain encrypted secrets.
installer/config/.encryption_key
installer/config/config.json.enc
installer/config/database.json.enc
installer/config/license.json.enc
installer/config/plugin_licenses/
installer/config/.install.lock
# The admin identity key pair. The .priv.enc file holds the site's RSA PRIVATE
# key — the highest-value secret in the system. It was NOT excluded before, so
# any local install could have staged it. Added with the Sprint 1 playground,
# which generates exactly these files.
installer/config/admin-identity.pub.enc
installer/config/admin-identity.priv.enc
# Playground access details written by scripts/dev/seed-playground.php.
installer/config/.playground-access

# ─── Encrypted Data (user content) ───────────────────────────
installer/data/*.json.enc
installer/data/**/*.json.enc
# Records are only written as *.json.enc when the configured encryption level
# covers that collection; at lower levels the SAME data lands as plain *.json.
# The patterns above therefore did not cover it. Exclude both forms.
installer/data/*.json
installer/data/**/*.json
installer/data/rate_limits.json
# The logs directory name is RANDOMISED per install (config 'logs_dir_name',
# e.g. data/logs-d8950d4907c6), so the fixed 'logs/' pattern never matched a
# real install. Cover both.
installer/data/logs/
installer/data/logs-*/
installer/data/_cache/
installer/data/.transaction.lock
installer/data/.cron.lock

# ─── Backups ─────────────────────────────────────────────────
installer/backups/*.zip
installer/backups/*.tar.gz

# ─── Generated Static Site ───────────────────────────────────
# The public site is generated by the build engine.
installer/public/index.html
installer/public/**/*.html
installer/public/css/style.css
installer/public/sitemap.xml
installer/public/robots.txt
installer/public/llms.txt
installer/public/llms-full.txt

# ─── Uploaded Assets (user content) ──────────────────────────
installer/public/assets/images/
installer/public/assets/uploads/

# ─── Plugin Data ─────────────────────────────────────────────
# Third-party plugins should not be committed.
# Core-bundled plugins can be tracked selectively.
installer/plugins/*/
!installer/plugins/.htaccess
!installer/plugins/hello-ai/
!installer/plugins/klytos-forms/
!installer/plugins/klytos-importer/
!installer/plugins/klytos-x402-coinbase/
!installer/plugins/klytos-x402-stripe/

# ─── Install file (renamed after install) ────────────────────
installer/.install.done.php

# ─── PHP Dependencies ────────────────────────────────────────
# Only exclude root-level vendor/ (Composer). Admin vendor assets are tracked.
/vendor/
composer.lock

# ─── Node.js (if used for build tools) ───────────────────────
node_modules/
package-lock.json
yarn.lock

# ─── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ─── Environment Files ───────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Keel / assistant local state (never commit) ──────────────
.keel-update-check
CLAUDE.local.md
AGENTS.override.md
.claude/settings.local.json
.gemini/.env
.gemini/tmp/
