#!/bin/sh
# Keel confidential-data gate — blocks commits that stage secrets.
# Rule source: Keel SKILL.md "Confidential data never reaches Git".
# Setup (per clone): git config core.hooksPath .githooks
# Bypass policy: fix the finding, or record the user's explicit OK in
# docs/decisions.md and repeat that single commit with --no-verify.

files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

fail=0
IFS='
'

# 1) Suspicious names — skipping the canonical trees that legitimately
# CONTAIN the gate's own patterns: the gate's script and the embedded Keel
# skill (either tree). The assistant-side check still scans them.
for f in $files; do
  case "$f" in .githooks/*|.claude/skills/*|.agents/skills/*) continue ;; esac
  base=$(basename "$f")
  case "$base" in
    .env|.env.*|*.pem|*.key|*.p12|*.pfx|id_rsa*|*credential*|*secret*|*.sql|*.sqlite|wp-config.php)
      printf 'BLOCKED (name): %s\n' "$f"; fail=1 ;;
  esac
done

# 2) Secret-shaped content in the STAGED blob (not the working tree)
# The api_key branch requires something VALUE-shaped after the separator (a
# run of at least 16 key-like characters, quoted or bare). Matching the key
# NAME alone flagged every one of the 20 locale catalogues, because they carry
# the translation key "api_key" whose value is the UI label "Gemini API key" —
# see D-037. A pattern that fires on documentation and labels trains people to
# pass --no-verify, which is worse than the narrower rule.
# The character classes spell out the case: this grep is deliberately NOT run
# with -i (that would make the AKIA/ghp_/sk- prefixes case-insensitive too,
# which loosens them), and the pre-existing lowercase-only branch never matched
# the very common camelCase `apiKey = "..."`.
#
# THE VALUE MUST ALSO CONTAIN A DIGIT, and that clause was added because the
# rule above only half-worked (D-097). "Requires something value-shaped" was
# meant to spare the catalogues, and it does — in ENGLISH, where the label is
# "Gemini API key" and the spaces break the run. Dutch and Swedish compound the
# same label into `Gemini-API-sleutel` and `Gemini-API-nyckel`: 16+ key-like
# characters, no spaces, and the gate blocked two locale files carrying nothing
# but a UI string. That is precisely the false positive the comment above says
# trains people to pass --no-verify.
#
# A digit is the discriminator because generated credentials are base16/62/64
# and effectively always carry one, while a 16+ run of letters and hyphens is a
# phrase in some language. It is a real if small loosening — an all-letter key
# would now pass this branch — and it is accepted knowingly: every well-known
# credential format has its own branch below (AKIA, sk-, ghp_, xox, Bearer,
# PEM), none of which this clause touches, so what is given up is the generic
# catch-all for a shape no issuer actually mints. Proven by planting a
# real-looking key and watching this hook refuse the commit.
pat="-----BEGIN [A-Z ]*PRIVATE KEY-----|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy][\"']?[[:space:]]*[:=][[:space:]]*[\"']?[A-Za-z0-9_\-]*[0-9][A-Za-z0-9_\-]*[A-Za-z0-9_\-]{15,}|Bearer [A-Za-z0-9._~+/=-]{20,}|AKIA[0-9A-Z]{16}|sk-(proj-)?[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{36,}|xox[baprs]-[A-Za-z0-9-]{10,}"
for f in $files; do
  case "$f" in .githooks/*|.claude/skills/*|.agents/skills/*) continue ;; esac
  if git show ":$f" 2>/dev/null | LC_ALL=C grep -Eqa -e "$pat"; then
    printf 'BLOCKED (content): %s matches a secret pattern\n' "$f"; fail=1
  fi
done

[ "$fail" -eq 0 ] && exit 0

cat <<'MSG'

Commit stopped by the Keel confidential-data gate.
A staged file looks like it carries secrets, credentials, keys, or real
personal data. Options, in order:
  1. Unstage it and add it to .gitignore (never tracked).
  2. Already tracked: git rm --cached <file> + .gitignore, commit the removal.
  3. Ever pushed: purge it from history (git filter-repo / BFG) AND rotate
     the credential — ignoring it is not enough.
  4. Genuinely safe (placeholders, sandbox keys meant to ship): record the
     user's explicit OK in docs/decisions.md, then repeat this one commit
     with --no-verify.
MSG
exit 1
