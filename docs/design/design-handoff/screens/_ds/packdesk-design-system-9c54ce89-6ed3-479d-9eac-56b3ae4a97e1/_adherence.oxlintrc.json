        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|trailing|mono|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, subtitle, trailing, mono, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:first|second|size|icon|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: first, second, size, icon."
