#!/usr/bin/env python3
"""keel-time — the only thing in this project that reads the clock.

Keel references/project-state.md, "Session time — scripts/keel-time and docs/sessions.md".

  start [--plan S-030,S-031]      open a session (closing one this log left open at its LAST event)
  slice-start <id>                open an interval for a slice; other open slices stay open
  slice-end <id> --status <s>     close THIS slice's interval; write its cumulative actual_hours
  slice-record <id> --result <worker-result.json> --status <s>
                                  record a worker's own interval at integration
  pause <reason> / resume         bracket every wait on the person
  end                             close open intervals, write the docs/sessions.md row, print the report
  report                          print the report for the session so far, writing nothing

Every subcommand reads the system clock itself (`date -u`) and appends keel.clock/1 events to
docs/.keel/clock.jsonl (gitignored). Interval arithmetic — overlap, pauses, worker intervals,
concurrency, throughput, the projection basis — is delegated to scripts/keel-clock, the byte-for-byte
copy of Keel's keel_clock.py. Plan figures come from docs/.keel/plan.json, regenerated by
scripts/keel-plan after every write to a sprint file.

Exclusive (single-writer) mode — slice-start closing the other open slices explicitly — applies only
when the card says `Parallel development: off` or the current sprint's frontmatter records
`effective_cap: 1`. Statuses for slice-end: done | in-progress | blocked.

KEEL_TIME_NOW=<YYYY-MM-DDTHH:MM:SSZ> replaces the system clock. It exists ONLY so the scripts can be
exercised in a scratch copy without waiting in real time; a real session never sets it.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CLOCK = ROOT / "scripts" / "keel-clock"
PLANNER = ROOT / "scripts" / "keel-plan"
LOG = ROOT / "docs" / ".keel" / "clock.jsonl"
PLAN = ROOT / "docs" / ".keel" / "plan.json"
SESSIONS = ROOT / "docs" / "sessions.md"
PROGRESS = ROOT / "docs" / "PROGRESS.md"
SPRINTS = ROOT / "docs" / "sprints"
SCHEMA = "keel.clock/1"
UNIT = "AI working time plus supervision"
STATUSES = ("done", "in-progress", "blocked")


class TimeError(Exception):
    pass


# ---- Clock and helpers -----------------------------------------------------

def now() -> str:
    override = os.environ.get("KEEL_TIME_NOW")
    if override:
        if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", override):
            raise TimeError("KEEL_TIME_NOW must be YYYY-MM-DDTHH:MM:SSZ")
        return override
    return subprocess.run(["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"], check=True, capture_output=True,
                          text=True).stdout.strip()


def ts(value: str) -> float:
    return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()


def local(value: str, fmt: str = "%H:%M %Z") -> str:
    return datetime.fromtimestamp(ts(value), tz=timezone.utc).astimezone().strftime(fmt)


def h(value, signed: bool = False) -> str:
    if value is None:
        return "—"
    text = f"{value:+.2f}" if signed else f"{value:.2f}"
    return text.rstrip("0").rstrip(".") + " h" if "." in text else text + " h"


def hm(hours: float) -> str:
    minutes = int(round(hours * 60))
    return f"{minutes // 60} h {minutes % 60:02d} min"


def clock(*args: str) -> dict:
    if not CLOCK.is_file():
        raise TimeError("scripts/keel-clock is missing — copy it from the installed Keel's scripts/keel_clock.py")
    run = subprocess.run([sys.executable, str(CLOCK), *args], capture_output=True, text=True)
    try:
        value = json.loads(run.stdout)
    except json.JSONDecodeError as exc:
        raise TimeError(f"keel-clock gave no JSON: {run.stdout!r} {run.stderr!r}") from exc
    if run.returncode != 0 or "error" in value:
        raise TimeError(f"keel-clock: {value.get('error', run.stderr.strip())}")
    return value


def regenerate_plan() -> None:
    run = subprocess.run([sys.executable, str(PLANNER)], capture_output=True, text=True)
    if run.returncode != 0:
        raise TimeError("scripts/keel-plan failed:\n" + run.stderr + run.stdout)


def load_plan() -> dict:
    if not PLAN.is_file():
        regenerate_plan()
    return json.loads(PLAN.read_text(encoding="utf-8"))


def events() -> list[dict]:
    if not LOG.is_file():
        return []
    return [json.loads(line) for line in LOG.read_text(encoding="utf-8").splitlines() if line.strip()]


def append(event: dict) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(dict({"schema": SCHEMA}, **event), sort_keys=True) + "\n")


def open_session(log: list[dict]):
    current = None
    for event in log:
        if event["event"] == "session-start":
            current = event
        elif event["event"] == "session-end" and current and event.get("session") == current["session"]:
            current = None
    return current


def require_session(log: list[dict]) -> dict:
    session = open_session(log)
    if not session:
        raise TimeError("no open session — run scripts/keel-time start first")
    return session


def paused(log: list[dict], session: str) -> bool:
    state = False
    for event in log:
        if event.get("session") != session:
            continue
        if event["event"] == "pause":
            state = True
        elif event["event"] == "resume":
            state = False
    return state


def slices_by_id(plan: dict) -> dict:
    return {s["id"]: dict(s, sprint=sp["sprint"]) for sp in plan.get("sprints", []) for s in sp["slices"]}


def parallel_mode(plan: dict, slice_id: str | None = None) -> bool:
    """True unless the card turns parallel development off or the sprint's effective cap is 1."""
    card = PROGRESS.read_text(encoding="utf-8") if PROGRESS.is_file() else ""
    match = re.search(r"Parallel development:\s*\**\s*([a-z]+)", card)
    if match and match.group(1) == "off":
        return False
    sprint_no = slices_by_id(plan).get(slice_id or "", {}).get("sprint")
    for path in SPRINTS.glob("sprint-*.md"):
        head = path.read_text(encoding="utf-8").split("\n---\n", 1)[0]
        if re.search(rf"^sprint:\s*{sprint_no}\s*$", head, re.M) and re.search(r"^effective_cap:\s*1\s*$", head, re.M):
            return False
    return True


# ---- Writing actual_hours into the sprint frontmatter ----------------------

def sprint_file_for(slice_id: str) -> Path:
    for path in sorted(SPRINTS.glob("sprint-*.md")):
        if re.search(rf"^  - id: {re.escape(slice_id)}\s*$", path.read_text(encoding="utf-8").split("\n---\n", 1)[0], re.M):
            return path
    raise TimeError(f"slice {slice_id} is in no docs/sprints/sprint-<N>.md (add it to the plan before working it)")


def write_actual(slice_id: str, hours: float, source: str, status: str | None) -> None:
    path = sprint_file_for(slice_id)
    text = path.read_text(encoding="utf-8")
    head, sep, body = text.partition("\n---\n")
    lines = head.split("\n")
    start = next(i for i, line in enumerate(lines) if re.fullmatch(rf"  - id: {re.escape(slice_id)}\s*", line))
    end = next((i for i in range(start + 1, len(lines)) if re.match(r"^  - id: |^\S", lines[i])), len(lines))
    replaced = {"actual_hours": False, "actual_source": False, "status": status is None}
    for i in range(start + 1, end):
        for key, value in (("actual_hours", f"{round(hours, 4)}"), ("actual_source", source)):
            if re.match(rf"^    {key}:", lines[i]):
                lines[i] = f"    {key}: {value}"
                replaced[key] = True
        if status and re.match(r"^    status:", lines[i]):
            lines[i] = f"    status: {status}"
            replaced["status"] = True
        if status == "done" and re.match(r"^    residual_hours:", lines[i]):
            lines[i] = "    residual_hours: 0"
    missing = [k for k, ok in replaced.items() if not ok]
    if missing:
        raise TimeError(f"{path.relative_to(ROOT)} {slice_id}: no {', '.join(missing)} line to update")
    path.write_text("\n".join(lines) + sep + body, encoding="utf-8")


def base_actual(log: list[dict], session: dict, slice_id: str) -> tuple[float, str | None]:
    """The slice's committed actual before this session, snapshotted at session start."""
    base = (session.get("base_actuals") or {}).get(slice_id)
    if base is None:
        return 0.0, None
    return float(base.get("hours") or 0.0), base.get("source")


def record_actual(slice_id: str, status: str) -> tuple[float, float]:
    """Writes the cumulative actual for one slice; returns (session hours, cumulative hours)."""
    log = events()
    session = require_session(log)
    load_plan()
    report = clock("report", "--log", str(LOG), "--session", session["session"], "--now", now(),
                   "--plan", str(PLAN))
    session_hours = next((r["session_hours"] for r in report["slices"] if r["id"] == slice_id), 0.0)
    base, base_source = base_actual(log, session, slice_id)
    total = base + session_hours
    source = "measured"
    if base_source == "estimated" and base > 0:
        source = "estimated"
        print(f"note: {slice_id} already carried a backfilled ESTIMATE of {h(base)}; the measured "
              f"{h(session_hours)} is added to it and the total stays labelled estimated — never relabelled.")
    sprint_status = {"done": "done", "in-progress": "in-progress", "blocked": "in-progress"}[status]
    write_actual(slice_id, total, source, sprint_status)
    regenerate_plan()
    return session_hours, total


# ---- Report ----------------------------------------------------------------

def measure(log_session: str, at: str) -> tuple[dict, dict]:
    plan = load_plan()
    args = ["report", "--log", str(LOG), "--session", log_session, "--now", at, "--plan", str(PLAN),
            "--sessions", str(SESSIONS)]
    if parallel_mode(plan):
        args.append("--parallel")
    return clock(*args), plan


def left_line(plan: dict) -> str:
    parts = []
    for sprint in plan["sprints"]:
        t = sprint["totals"]
        if t["slices_open"]:
            parts.append(f"sprint {sprint['sprint']} — {t['slices_open']} slice(s), {h(t['remaining_hours'])}")
    total = plan["totals"]
    label = "" if total["reconciliation_status"] == "reconciled" else " (unreconciled baseline)"
    return " · ".join(parts + [f"total {h(total['remaining_hours'])}{label}"])


def print_report(report: dict, plan: dict, session: dict, closing: bool) -> list[str]:
    by_id = slices_by_id(plan)
    planned = session.get("planned") or []
    out = []
    head = "Session" if closing else "Session so far"
    out.append(f"{head} — {local(report['start'])} → {local(report['end'])} "
               f"({hm(report['wall_clock_hours'])} wall-clock, {hm(report['paused_hours'])} paused, "
               f"{hm(report['active_hours'])} active)")
    mode = "parallel" if report["max_concurrency"] > 1 else "serial"
    extra = " — worker elapsed working time, overlapping" if report["max_concurrency"] > 1 else ""
    out.append(f"Slice hours (sum of each slice's own intervals): {h(report['summed_slice_hours'])} · "
               f"max concurrency {report['max_concurrency']} ({mode}){extra}")
    out.append(f"Planned at start: {', '.join(planned) or 'nothing named'} — {h(session.get('planned_hours') or 0)}")
    rows = {r["id"]: r for r in report["slices"]}
    done = [r for r in report["slices"] if r["status"] == "done"]
    unfinished = [r for r in report["slices"] if r["status"] != "done"]
    out.append("Done:" if done else "Done: none this session")
    for r in done:
        title = by_id.get(r["id"], {}).get("title", "")
        out.append(f"  {r['id']} {title} — estimated {h(r['estimated_hours'])}, measured "
                   f"{h(r['measured_hours'])} ({h(r['deviation_hours'], True)})")
    if unfinished:
        out.append("Not finished:")
        for r in unfinished:
            item = by_id.get(r["id"], {})
            out.append(f"  {r['id']} {item.get('title', '')} — estimated {h(r['estimated_hours'])}, "
                       f"{h(r['session_hours'])} spent this session")
    for pid in planned:
        if pid not in rows:
            item = by_id.get(pid, {})
            out.append(f"  {pid} {item.get('title', '')} — planned, not started")
    unplanned = [r for r in report["slices"] if r["id"] not in planned]
    if unplanned:
        out.append("Unplanned, added this session:")
        for r in unplanned:
            out.append(f"  {r['id']} {by_id.get(r['id'], {}).get('title', '')} — estimated "
                       f"{h(r['estimated_hours'])}, measured {h(r['measured_hours'])}")
    if report["done_estimated_hours"]:
        pct = report["deviation_percent"]
        out.append(f"Deviation on finished work: estimated {h(report['done_estimated_hours'])} → measured "
                   f"{h(report['done_measured_hours'])} ({h(report['deviation_hours'], True)}, {pct:+.1f} %)")
    else:
        out.append("Deviation on finished work: unavailable — nothing finished this session")
    if report["throughput"] is not None:
        out.append(f"Throughput: {h(report['done_estimated_hours'])} estimated finished in "
                   f"{h(report['active_hours'])} active ({report['throughput']:.2f} estimated h per wall-clock h)")
    else:
        out.append("Throughput: unavailable — no estimated work finished this session")
    out.append(f"Left according to plan: {left_line(plan)}")
    t = plan["totals"]
    sample = t.get("pace_sample") or {}
    if t.get("pace_factor") is not None:
        out.append(f"Cumulative measured finished work: estimated {h(sample['original_hours'])} → measured "
                   f"{h(sample['actual_hours'])} ({(t['pace_factor'] - 1) * 100:+.1f} %, factor "
                   f"{t['pace_factor']:.4f}; {sample['slices']} slices{', provisional sample' if sample.get('provisional') else ''})")
    else:
        out.append("Cumulative measured finished work: unavailable — no measured completed work "
                   "(every actual so far is a backfilled estimate)")
    proj = report["projection"]
    if proj["basis"] == "throughput":
        s = proj["throughput_sample"]
        out.append(f"Projection if the observed throughput continues (basis: throughput — {s['sessions']} parallel "
                   f"session(s), {h(s['estimated_hours'])} estimated in {h(s['active_hours'])} active): total "
                   f"{h(proj['projected_remaining_hours'])} wall-clock")
        if t.get("pace_factor") is not None:
            out.append(f"Effort pace on finished work: factor {t['pace_factor']:.4f} ({sample['slices']} slices) — "
                       "calibration of each slice's estimate, not elapsed time")
    elif proj["basis"] == "pace":
        out.append(f"Projection if the observed pace continues (basis: pace — serial work): total "
                   f"{h(proj['projected_remaining_hours'])}" + (f" ({proj['reason']})" if proj["reason"] else ""))
    elif proj["basis"] == "none":
        out.append("Projection: 0 h (basis: none — no work remains)")
    else:
        out.append(f"Projection: {proj['reason']}")
    out.append(f"All figures are {UNIT}.")
    print("\n".join(out))
    return out


def sessions_row(report: dict, plan: dict, session: dict, notes: list[str]) -> str:
    planned = session.get("planned") or []
    done = [r for r in report["slices"] if r["status"] == "done"]
    unfinished = [r for r in report["slices"] if r["status"] != "done"]
    proj = report["projection"]
    t = plan["totals"]

    def n(value, digits=2):
        return "—" if value is None else f"{value:.{digits}f}"

    if proj["reason"]:
        notes.append(proj["reason"])
    if t.get("pace_factor") is None:
        notes.append("pace factor unavailable — no measured completed work")
    if report["throughput"] is None:
        notes.append("throughput unavailable — nothing finished this session")
    if t.get("reconciliation_status") == "unreconciled":
        notes.append("left after h is an unreconciled baseline")
    if report["max_concurrency"] > 1 and proj["basis"] == "pace":
        notes.append("max concurrency above 1 on basis pace: no parallel session has finished estimated work yet")
    cells = [
        local(report["start"], "%Y-%m-%d %H:%M %z"),
        local(report["end"], "%Y-%m-%d %H:%M %z"),
        n(report["wall_clock_hours"], 4),
        n(report["paused_hours"], 4),
        (", ".join(planned) or "—") + f" ({n(session.get('planned_hours') or 0)})",
        ", ".join(r["id"] for r in done) or "—",
        n(report["done_estimated_hours"], 4),
        n(report["done_measured_hours"], 4),
        n(report["done_measured_hours"] - report["done_estimated_hours"], 4),
        ", ".join(f"{r['id']} ({n(r['session_hours'], 4)})" for r in unfinished) or "—",
        n(plan["totals"]["remaining_hours"]),
        n(report["active_hours"], 4),
        n(t.get("pace_factor"), 4),
        n(proj["projected_remaining_hours"]),
        n(report["summed_slice_hours"], 4),
        str(report["max_concurrency"]),
        n(report["throughput"]),
        proj["basis"] or "—",
        "; ".join(dict.fromkeys(notes)) or "—",
    ]
    return "| " + " | ".join(c.replace("|", "/") for c in cells) + " |"


def append_row(row: str) -> None:
    if not SESSIONS.is_file():
        raise TimeError("docs/sessions.md is missing")
    text = SESSIONS.read_text(encoding="utf-8")
    SESSIONS.write_text(text.rstrip("\n") + "\n" + row + "\n", encoding="utf-8")


def close_session(session: dict, at: str, notes: list[str], closing_print: bool = True) -> None:
    """Closes open coordinator intervals as in-progress, writes partial actuals, the row and the report."""
    log = events()
    open_ids = [e for e in clock("report", "--log", str(LOG), "--session", session["session"], "--now", at)["slices"]
                if e["status"] == "in-progress" and e["source"].find("coordinator") >= 0]
    for item in open_ids:
        try:
            clock("slice-end", item["id"], "--log", str(LOG), "--session", session["session"], "--at", at,
                  "--status", "in-progress")
        except TimeError:
            continue  # already closed as in-progress earlier this session
    if paused(log, session["session"]):
        append({"event": "resume", "at": at, "session": session["session"], "note": "closed by end"})
    append({"event": "session-end", "at": at, "session": session["session"],
            **({"unterminated": True} if "unterminated" in notes else {})})
    measured = clock("report", "--log", str(LOG), "--session", session["session"], "--plan", str(PLAN))
    for row in measured["slices"]:
        if row["status"] != "done" and row["session_hours"] > 0:
            base, base_source = base_actual(log, session, row["id"])
            source = "estimated" if base_source == "estimated" and base > 0 else "measured"
            try:
                write_actual(row["id"], base + row["session_hours"], source, "in-progress")
            except TimeError as exc:
                notes.append(str(exc))
    regenerate_plan()
    report, plan = measure(session["session"], at)
    if closing_print:
        print_report(report, plan, session, closing=True)
    append_row(sessions_row(report, plan, session, notes))


# ---- Subcommands -----------------------------------------------------------

def cmd_start(argv: list[str]) -> None:
    planned_arg = None
    if argv[:1] == ["--plan"] and len(argv) > 1:
        planned_arg = [p.strip() for p in argv[1].split(",") if p.strip()]
    elif argv:
        raise TimeError("usage: keel-time start [--plan S-030,S-031]")
    log = events()
    left_open = open_session(log)
    if left_open:
        last = max((e["at"] for e in log if e.get("session") == left_open["session"]
                    and e.get("source") != "worker"), key=ts)
        print(f"Closing the session this log left open ({left_open['session']}) at its last recorded event, "
              f"{local(last)} — marked unterminated.")
        close_session(left_open, last, ["unterminated"], closing_print=False)
    regenerate_plan()
    plan = load_plan()
    by_id = slices_by_id(plan)
    if planned_arg is None:
        position = ""
        if PROGRESS.is_file():
            text = PROGRESS.read_text(encoding="utf-8")
            match = re.search(r"^## Current position\n(.*?)(?=^## )", text, re.S | re.M)
            position = match.group(1) if match else ""
        named = [sid for sid in dict.fromkeys(re.findall(r"\bS-\d{3,}\b", position))
                 if by_id.get(sid, {}).get("status") in ("not-started", "in-progress")]
        planned_arg = named[:1] or plan["queue"]["workable_ids"][:1]
    unknown = [p for p in planned_arg if p not in by_id]
    if unknown:
        raise TimeError(f"not in the plan: {', '.join(unknown)} — add the slice(s) to a sprint file first")
    at = now()
    planned_hours = sum(by_id[p].get("residual_hours") or 0 for p in planned_arg)
    base = {sid: {"hours": s.get("actual_hours"), "source": s.get("actual_source")}
            for sid, s in by_id.items() if s.get("actual_hours") is not None}
    append({"event": "session-start", "at": at, "session": at, "planned": planned_arg,
            "planned_hours": planned_hours, "base_actuals": base})
    print(f"Session start — {local(at, '%a %d %b %Y, %H:%M %Z')} (system clock)")
    print(f"Left: {left_line(plan)}")
    print("This session plans:")
    for sid in planned_arg:
        print(f"  {sid} {by_id[sid]['title']} — {h(by_id[sid].get('residual_hours'))}")
    print(f"  Planned: {h(planned_hours)} of {UNIT}")
    queue = plan["queue"]
    print(f"Queue: {queue['workable']} workable, {queue['waiting']} waiting on a person or event")


def cmd_slice_start(argv: list[str]) -> None:
    if len(argv) != 1:
        raise TimeError("usage: keel-time slice-start <id>")
    sid = argv[0]
    log = events()
    session = require_session(log)
    plan = load_plan()
    if sid not in slices_by_id(plan):
        raise TimeError(f"{sid} is not in the plan — add it to a sprint file before its first change")
    args = ["slice-start", sid, "--log", str(LOG), "--session", session["session"], "--at", now()]
    if not parallel_mode(plan, sid):
        args.append("--exclusive")
    result = clock(*args)
    if not result["appended"]:
        print(f"{sid} is already open — nothing to do")
    for event in result["appended"]:
        verb = "opened" if event["event"] == "slice-start" else "closed (exclusive mode, in-progress)"
        print(f"{event['slice']} {verb} at {local(event['at'])}")


def cmd_slice_end(argv: list[str]) -> None:
    if len(argv) != 3 or argv[1] != "--status" or argv[2] not in STATUSES:
        raise TimeError("usage: keel-time slice-end <id> --status done|in-progress|blocked")
    sid, status = argv[0], argv[2]
    session = require_session(events())
    clock("slice-end", sid, "--log", str(LOG), "--session", session["session"], "--at", now(), "--status", status)
    spent, total = record_actual(sid, status)
    item = slices_by_id(load_plan()).get(sid, {})
    est = item.get("original_hours")
    print(f"{sid} closed ({status}) — this session {h(spent)}, cumulative {h(total)} measured; "
          f"estimated {h(est)}" + (f" ({h(total - est, True)})" if status == "done" and est is not None else ""))


def cmd_slice_record(argv: list[str]) -> None:
    if len(argv) != 5 or argv[1] != "--result" or argv[3] != "--status" or argv[4] not in STATUSES:
        raise TimeError("usage: keel-time slice-record <id> --result <worker-result.json> --status <s>")
    sid, result, status = argv[0], argv[2], argv[4]
    session = require_session(events())
    outcome = clock("record-worker", sid, "--log", str(LOG), "--result", result, "--status", status,
                    "--session", session["session"])
    if outcome.get("duplicate"):
        print(f"{sid}: that worker attempt is already recorded — nothing appended")
    spent, total = record_actual(sid, status)
    print(f"{sid} recorded from the worker's own interval ({status}) — {h(spent)} this session, cumulative {h(total)}")


def cmd_pause(argv: list[str]) -> None:
    log = events()
    session = require_session(log)
    if paused(log, session["session"]):
        raise TimeError("already paused — resume first")
    reason = " ".join(argv).strip() or "waiting on the person"
    at = now()
    append({"event": "pause", "at": at, "session": session["session"], "reason": reason})
    print(f"Paused at {local(at)} — {reason}")


def cmd_resume(argv: list[str]) -> None:
    log = events()
    session = require_session(log)
    if not paused(log, session["session"]):
        raise TimeError("not paused")
    at = now()
    append({"event": "resume", "at": at, "session": session["session"]})
    print(f"Resumed at {local(at)}")


def cmd_end(argv: list[str]) -> None:
    session = require_session(events())
    close_session(session, now(), [])
    print("Row appended to docs/sessions.md; docs/.keel/plan.json regenerated.")


def cmd_report(argv: list[str]) -> None:
    session = require_session(events())
    report, plan = measure(session["session"], now())
    print_report(report, plan, session, closing=False)


COMMANDS = {"start": cmd_start, "slice-start": cmd_slice_start, "slice-end": cmd_slice_end,
            "slice-record": cmd_slice_record, "pause": cmd_pause, "resume": cmd_resume,
            "end": cmd_end, "report": cmd_report}


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in COMMANDS:
        print(__doc__)
        return 2
    try:
        COMMANDS[argv[0]](argv[1:])
        return 0
    except (TimeError, OSError, ValueError, KeyError, subprocess.CalledProcessError) as exc:
        print(f"keel-time: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
