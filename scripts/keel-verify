#!/usr/bin/env php
<?php

/**
 * Klytos CMS — keel-verify: the project's own release linter.
 *
 * Keel Phase 5 §1a: verify mechanically that what the docs and the
 * architecture PROMISE is actually true, so no session re-checks it by eye and
 * no release ships with a promise quietly broken.
 *
 * Introduced in Sprint 1 slice 4 carrying the authorization-gate check, which
 * is the promise that most needs a machine behind it: S-07 happened because 51
 * of 66 admin files were each individually responsible for remembering their
 * own gate, and a reviewer cannot hold 66 files in their head every time one is
 * added.
 *
 * Slice 9 extends this with the remaining Phase 5 §1a checks that apply to this
 * project. Each check is independent and self-reporting: add one, do not
 * restructure.
 *
 * Three checks are deliberately absent, so their absence reads as a decision
 * rather than an oversight:
 *   - Minified-asset sync — N/A per D-038. All 68 tracked *.min.* files are
 *     third-party vendor distributions; Klytos ships no minified first-party
 *     asset, so there is no source↔minified drift that could exist to detect.
 *   - WordPress i18n sniffs — N/A per D-006. This is not a WordPress project.
 *     The equivalent real invariant here is catalogue key parity across the 20
 *     locales, which IS checked below.
 *   - By-reference hook listeners (audit NEW-03) — N/A per D-054. The contract
 *     is enforced at RUNTIME: Hooks::addAction()/addFilter() reflect every
 *     callback and throw HookContractException. That is universal and cannot be
 *     bypassed by how a call site is spelled, whereas a static source check
 *     could only approximate it and could disagree with it. A source scan does
 *     exist, in tests/Unit/HooksTest.php, and it guards one narrower property:
 *     that CORE registers no such listener — because core is loaded outside
 *     PluginLoader's try/catch, so a throw there would take down boot.
 *
 * PASS/FAIL vs WARN: a check WARNs when the property is genuinely broken but
 * fixing it belongs to another phase that already owns it. A WARN prints the
 * full evidence and does not change the exit code — the point is that the
 * drift is visible in every run instead of being rediscovered, which is what
 * sprint-1.md means by "slice 9 makes H-01 detectable now".
 *
 * Usage:  php scripts/keel-verify        (exit 0 = all checks pass)
 *
 * @package Klytos
 *
 * @license    GPL-3.0-or-later — https://www.gnu.org/licenses/gpl-3.0.html
 * @copyright  Copyright (c) 2026 José Conti — https://plugins.joseconti.com — https://klytos.io
 *             This program is free software: you can redistribute it and/or modify
 *             it under the terms of the GNU General Public License v3 or later.
 *             Plugins and templates are NOT derivative works — see LICENSE.
 *             See the LICENSE file at the project root for the full license text.
 */

declare(strict_types=1);

$repoRoot  = dirname( __DIR__ );
$adminPath = $repoRoot . '/installer/admin';

$failures     = [];
$warnings     = [];
$warnedChecks = 0;
$checks       = 0;

/**
 * Report a check's outcome and accumulate its failures.
 *
 * @param  string             $name     Check name.
 * @param  array<int, string> $problems Empty when the check passes.
 * @return void
 */
function keel_report( string $name, array $problems ): void
{
    global $failures, $checks;

    $checks++;

    if ( $problems === [] ) {
        echo "  PASS  {$name}\n";
        return;
    }

    echo "  FAIL  {$name}\n";

    foreach ( $problems as $problem ) {
        echo "          - {$problem}\n";
        $failures[] = $name . ': ' . $problem;
    }
}

/**
 * Report a check whose failure is owned by another phase.
 *
 * Prints the full evidence and does NOT affect the exit code. Used only where
 * a decision already assigns the fix elsewhere; anything else must FAIL.
 *
 * @param  string             $name  Check name.
 * @param  array<int, string> $notes Empty when the check passes.
 * @return void
 */
function keel_warn( string $name, array $notes ): void
{
    global $warnings, $warnedChecks, $checks;

    $checks++;

    if ( $notes === [] ) {
        echo "  PASS  {$name}\n";
        return;
    }

    $warnedChecks++;

    echo "  WARN  {$name}\n";

    foreach ( $notes as $note ) {
        echo "          - {$note}\n";
        $warnings[] = $name . ': ' . $note;
    }
}

/**
 * Run a git command from the repository root, or return null when git is
 * unavailable. Every git-dependent check degrades to "skipped" rather than
 * failing, so keel-verify still works where git is not on PATH.
 *
 * @param  string $args Arguments appended to `git`.
 * @return array<int, string>|null Output lines, or null when git failed.
 */
function keel_git( string $args ): ?array
{
    global $repoRoot;

    $output = [];
    $status = 1;

    exec( 'git -C ' . escapeshellarg( $repoRoot ) . ' ' . $args . ' 2>/dev/null', $output, $status );

    return $status === 0 ? $output : null;
}

/**
 * Split a markdown table row into its cells, honouring `\|` escapes.
 *
 * Needed rather than a bare explode: one test-point evidence cell quotes a PHP
 * TypeError containing `Countable|array`, escaped as `\|` so the table still
 * renders. Splitting on that pipe would move every cell after it into the wrong
 * column — including the one being checked.
 *
 * @param  string $row Raw table row, outer pipes included.
 * @return array<int, string>
 */
function keel_table_cells( string $row ): array
{
    $row = trim( $row );
    $row = (string) preg_replace( '/^\|/', '', $row );
    $row = (string) preg_replace( '/\|$/', '', $row );

    return array_map( 'trim', (array) preg_split( '/(?<!\\\\)\|/', $row ) );
}

/**
 * Flatten a decoded JSON catalogue into dot-notation keys.
 *
 * @param  array<string, mixed> $data   Decoded catalogue.
 * @param  string               $prefix Accumulated key prefix.
 * @return array<int, string>
 */
function keel_flatten_keys( array $data, string $prefix = '' ): array
{
    $keys = [];

    foreach ( $data as $key => $value ) {
        $path = $prefix === '' ? (string) $key : $prefix . '.' . $key;

        if ( is_array( $value ) ) {
            $keys = array_merge( $keys, keel_flatten_keys( $value, $path ) );
            continue;
        }

        $keys[] = $path;
    }

    return $keys;
}

/**
 * Parse docs/api/INDEX.md into its Summary counts and its per-section rows.
 *
 * A markdown table row is a DATA row when it is neither the `|---|` separator
 * nor the header line immediately above one — which is what makes the row
 * count independent of how many columns a section happens to carry.
 *
 * @param  string $markdown Raw INDEX.md contents.
 * @return array{summary: array<string, int>, sections: array<string, array<int, array<int, string>>>}
 */
function keel_parse_index( string $markdown ): array
{
    $lines    = explode( "\n", $markdown );
    $summary  = [];
    $sections = [];
    $section  = '';
    $total    = count( $lines );

    for ( $i = 0; $i < $total; $i++ ) {
        $line = trim( $lines[ $i ] );

        if ( str_starts_with( $line, '## ' ) ) {
            $section = trim( substr( $line, 3 ) );
            continue;
        }

        if ( ! str_starts_with( $line, '|' ) ) {
            continue;
        }

        // Separator row, or the header sitting directly above one.
        if ( str_starts_with( $line, '|-' ) || str_starts_with( $line, '| -' ) ) {
            continue;
        }

        $next = isset( $lines[ $i + 1 ] ) ? trim( $lines[ $i + 1 ] ) : '';

        if ( str_starts_with( $next, '|-' ) || str_starts_with( $next, '| -' ) ) {
            continue;
        }

        $cells = array_map( 'trim', explode( '|', trim( $line, '|' ) ) );

        if ( $section === 'Summary' ) {
            $label = trim( $cells[0], '* ' );
            $count = (int) str_replace( [ '*', ',' ], '', $cells[1] ?? '0' );

            $summary[ $label ] = $count;
            continue;
        }

        $sections[ $section ][] = $cells;
    }

    return [ 'summary' => $summary, 'sections' => $sections ];
}

echo "keel-verify — Klytos CMS\n\n";

// ─────────────────────────────────────────────────────────────
// Check: every admin surface carries an authorization gate entry (S-07).
// ─────────────────────────────────────────────────────────────

// The map is plain data behind one function. Stub the filter so the file can
// be read WITHOUT booting the application: this check must work on a bare
// checkout, in CI, and before a release, none of which have a seeded install.
// The stub also means the check verifies the SHIPPED map rather than whatever
// a locally-installed plugin filters it into — which is the right subject for
// a release gate.
if ( ! function_exists( 'klytos_apply_filters' ) ) {
    /**
     * @param  string $hook  Unused.
     * @param  mixed  $value Value to pass through unchanged.
     * @return mixed
     */
    function klytos_apply_filters( string $hook, mixed $value, mixed ...$args ): mixed
    {
        return $value;
    }
}

require_once $repoRoot . '/installer/core/admin-gate.php';

$map      = klytos_admin_gate_map();
$problems = [];
$onDisk   = [];

foreach ( glob( $adminPath . '/*.php' ) ?: [] as $file ) {
    $name = basename( $file );

    // bootstrap.php HOSTS the gate; it is not a surface the gate protects, and
    // leaving it unmapped is what makes a direct request for it default-deny.
    if ( $name === 'bootstrap.php' ) {
        continue;
    }

    $onDisk[] = $name;
}

foreach ( glob( $adminPath . '/api/*.php' ) ?: [] as $file ) {
    $onDisk[] = 'api/' . basename( $file );
}

sort( $onDisk );

foreach ( $onDisk as $surface ) {
    if ( ! array_key_exists( $surface, $map ) ) {
        $problems[] = "admin/{$surface} has no entry in klytos_admin_gate_map() — it is denied "
            . 'to everyone by default. Map it deliberately in installer/core/admin-gate.php.';
    }
}

foreach ( array_keys( $map ) as $surface ) {
    if ( ! in_array( $surface, $onDisk, true ) ) {
        $problems[] = "the gate map names admin/{$surface}, which does not exist on disk.";
    }
}

if ( array_key_exists( 'bootstrap.php', $map ) ) {
    $problems[] = 'bootstrap.php must NOT be mapped: it is the gate host, not a routable surface.';
}

keel_report(
    sprintf( 'authorization gate covers every admin surface (%d files)', count( $onDisk ) ),
    $problems
);

// ─────────────────────────────────────────────────────────────
// Check: the central gate is actually invoked.
// ─────────────────────────────────────────────────────────────
// A complete map enforces nothing if nobody calls the enforcer. This is the
// difference between a gate and a spreadsheet about gates.

$bootstrap = (string) file_get_contents( $adminPath . '/bootstrap.php' );
$problems  = [];

if ( ! str_contains( $bootstrap, 'klytos_enforce_admin_gate(' ) ) {
    $problems[] = 'admin/bootstrap.php does not call klytos_enforce_admin_gate() — the gate map '
        . 'is complete but nothing enforces it, so every admin surface is open.';
}

keel_report( 'the central gate is invoked from admin/bootstrap.php', $problems );

// ─────────────────────────────────────────────────────────────
// Check: docs/api/INDEX.md Summary counts match the rows below them.
// ─────────────────────────────────────────────────────────────
// The Summary block is hand-maintained, so it drifts silently: a slice adds
// rows and the totals keep asserting yesterday's number. Nothing else in the
// project would ever notice.

$indexPath = $repoRoot . '/docs/api/INDEX.md';
$problems  = [];
$index     = [ 'summary' => [], 'sections' => [] ];

if ( ! is_file( $indexPath ) ) {
    $problems[] = 'docs/api/INDEX.md does not exist.';
} else {
    $index = keel_parse_index( (string) file_get_contents( $indexPath ) );
    $sum   = 0;

    foreach ( $index['summary'] as $label => $claimed ) {
        if ( $label === 'Total' ) {
            continue;
        }

        $actual = count( $index['sections'][ $label ] ?? [] );
        $sum   += $actual;

        if ( ! array_key_exists( $label, $index['sections'] ) ) {
            $problems[] = "the Summary claims {$claimed} '{$label}' but there is no '## {$label}' "
                . 'section in the file.';
            continue;
        }

        if ( $actual !== $claimed ) {
            $problems[] = "Summary says {$claimed} for '{$label}'; the section holds {$actual} rows.";
        }
    }

    $claimedTotal = $index['summary']['Total'] ?? -1;

    if ( $claimedTotal !== $sum ) {
        $problems[] = "Summary total says {$claimedTotal}; the sections hold {$sum} rows.";
    }
}

keel_report( 'docs/api/INDEX.md summary counts match its rows', $problems );

// ─────────────────────────────────────────────────────────────
// Check: docs/api/INDEX.md parity — rows and docs agree, both directions.
// ─────────────────────────────────────────────────────────────
// Phase 5 §2 calls an INDEX row without its doc, or a doc without its row, a
// slice defect. Slice 8 added rows by hand and corrected two; this is what
// stops the next slice forgetting.

$problems   = [];
$referenced = [];

foreach ( $index['sections'] as $section => $rows ) {
    foreach ( $rows as $cells ) {
        // Every surface section carries the same shape:
        // | Surface | Kind | Code file | Doc | Purpose |
        $doc = $cells[3] ?? '—';

        if ( $doc === '' || $doc === '—' || $doc === '-' ) {
            continue;
        }

        $referenced[ $doc ] = true;

        if ( ! is_file( $repoRoot . '/' . $doc ) ) {
            $surface = $cells[0] ?? '(unnamed)';
            $problems[] = "row '{$surface}' in '{$section}' points at {$doc}, which does not exist.";
        }
    }
}

$onDiskDocs = array_merge(
    glob( $repoRoot . '/docs/api/*.md' ) ?: [],
    glob( $repoRoot . '/docs/reference/*.md' ) ?: []
);

foreach ( $onDiskDocs as $docPath ) {
    $relative = ltrim( str_replace( $repoRoot, '', $docPath ), '/' );

    // INDEX.md is the index itself, not a surface doc it could list.
    if ( $relative === 'docs/api/INDEX.md' ) {
        continue;
    }

    if ( ! isset( $referenced[ $relative ] ) ) {
        $problems[] = "{$relative} exists but no INDEX row points at it — every doc needs its row.";
    }
}

keel_report( 'docs/api/INDEX.md parity: every row has its doc, every doc its row', $problems );

// ─────────────────────────────────────────────────────────────
// Check: every locale catalogue in a set carries the same key set.
// ─────────────────────────────────────────────────────────────
// This is the i18n invariant that actually exists here (D-006: custom
// key-based JSON, no gettext). Slices 7 and 8 both added keys to all 20
// catalogues BY HAND — this is what catches the one that gets missed.

$problems      = [];
// `installer/lang/*` is a THIRD catalogue root and was not covered until entry
// 37 built the screen that reads one. The x402 module registers its catalogues
// from there (`klytos_register_translations( 'klytos-x402', … )`), and four of
// its twenty files had been two keys short since the module shipped — invisible
// because this check only ever looked at the two roots it was written against.
// A check that proves the directories it happens to know about is L-030's shape
// in a check; the fix is the extra root, not a note to remember.
$catalogueDirs = array_merge(
    [ $repoRoot . '/installer/core/lang' ],
    glob( $repoRoot . '/installer/lang/*', GLOB_ONLYDIR ) ?: [],
    glob( $repoRoot . '/installer/plugins/*/lang' ) ?: []
);
$catalogueCount = 0;

foreach ( $catalogueDirs as $dir ) {
    $files = glob( $dir . '/*.json' ) ?: [];
    sort( $files );

    $label     = ltrim( str_replace( $repoRoot, '', $dir ), '/' );
    $reference = null;
    $refName   = '';

    foreach ( $files as $file ) {
        $catalogueCount++;

        $decoded = json_decode( (string) file_get_contents( $file ), true );

        if ( ! is_array( $decoded ) ) {
            $problems[] = "{$label}/" . basename( $file ) . ' is not valid JSON.';
            continue;
        }

        $keys = keel_flatten_keys( $decoded );
        sort( $keys );

        if ( $reference === null ) {
            $reference = $keys;
            $refName   = basename( $file );
            continue;
        }

        $missing = array_diff( $reference, $keys );
        $extra   = array_diff( $keys, $reference );

        foreach ( $missing as $key ) {
            $problems[] = "{$label}/" . basename( $file ) . " is missing key '{$key}' "
                . "(present in {$refName}).";
        }

        foreach ( $extra as $key ) {
            $problems[] = "{$label}/" . basename( $file ) . " carries key '{$key}' "
                . "that {$refName} does not.";
        }
    }
}

keel_report(
    sprintf(
        'locale catalogues agree on their key set (%d files across %d sets)',
        $catalogueCount,
        count( $catalogueDirs )
    ),
    $problems
);

// ─────────────────────────────────────────────────────────────
// Check: every `__( 'root.key' )` call resolves in a catalogue.
// ─────────────────────────────────────────────────────────────
// Added 2026-08-10 for L-046, whose whole point is that NOTHING here could see
// the defect it names. The parity check above compares the 20 files AGAINST
// EACH OTHER, so twenty catalogues can agree perfectly about a root nobody
// calls while the screen that needs it prints its own keys — which is exactly
// what entry 28 shipped, in all 20 languages, for as long as it existed. And a
// missing key renders as the key itself (`core/i18n.php::get()`), silently: no
// error, no console warning, no failed request. Between the parity check and
// nothing at all lay a gap the width of that defect, and prose cannot close it.
//
// Both directions, reported differently because they are not the same fact:
//
//   FAIL — a call that resolves in no catalogue. That is always a defect: the
//          person is shown `taxonomy.field_slug` where a sentence belongs.
//   WARN — a root no PHP or JS file references. Dead weight, or a catalogue
//          shipped ahead of a screen that has not been built yet. Worth seeing
//          every time; not something this check may decide to delete.
//
// The scan uses the PHP tokenizer rather than a regular expression, so a key
// named inside a comment or a docblock is not a call (`core/i18n.php` documents
// `__('hello_ai.modal_title')` in its own docblock), and a key built by
// concatenation — `__( 'security.enc_' . $level )` — is skipped rather than
// reported as missing, because its full name is not knowable here.

$catalogueKeys  = [];
$catalogueRoots = [];

foreach ( $catalogueDirs as $dir ) {
    foreach ( glob( $dir . '/*.json' ) ?: [] as $file ) {
        $decoded = json_decode( (string) file_get_contents( $file ), true );
        if ( ! is_array( $decoded ) ) {
            continue;
        }
        foreach ( keel_flatten_keys( $decoded ) as $key ) {
            $catalogueKeys[ $key ] = true;
        }
        foreach ( array_keys( $decoded ) as $top ) {
            // A catalogue may be nested (`"taxonomy": { "add": … }`) or flat
            // (`"hello_ai.button_label": …`) — `core/i18n.php` resolves both.
            // The ROOT is the part before the first dot either way; reading the
            // flat form as a root of its own produced one "orphan" per string.
            $root = explode( '.', (string) $top )[0];
            if ( $root !== '_meta' ) {
                $catalogueRoots[ $root ] = true;
            }
        }
    }
}

/**
 * Every PHP file that could carry a `__()` call, product code only.
 *
 * `installer/*.php` is listed explicitly: `install.php` is the setup wizard and
 * the only consumer of the whole `install` catalogue root, so leaving the
 * directory's own top level out reported that root as an orphan — the check
 * accusing the tree of a defect that was the check's own blind spot (L-043).
 */
$sourceFiles = glob( $repoRoot . '/installer/*.php' ) ?: [];
foreach ( [ '/installer/core', '/installer/admin', '/installer/plugins', '/installer/public' ] as $sub ) {
    $dir = $repoRoot . $sub;
    if ( ! is_dir( $dir ) ) {
        continue;
    }
    $walker = new RecursiveIteratorIterator( new RecursiveDirectoryIterator( $dir ) );
    foreach ( $walker as $entry ) {
        if ( $entry->isFile() && in_array( $entry->getExtension(), [ 'php', 'js' ], true ) ) {
            $sourceFiles[] = $entry->getPathname();
        }
    }
}
sort( $sourceFiles );

$problems  = [];
$callCount = 0;
$rootsUsed = [];

foreach ( $sourceFiles as $file ) {
    $source   = (string) file_get_contents( $file );
    $relative = ltrim( str_replace( $repoRoot, '', $file ), '/' );

    if ( substr( $file, -3 ) === '.js' ) {
        // JS never calls `__()` here; it carries catalogue text on data
        // attributes. Root usage is still counted, so a root read only from a
        // script is not reported as an orphan.
        foreach ( array_keys( $catalogueRoots ) as $root ) {
            if ( strpos( $source, $root . '.' ) !== false ) {
                $rootsUsed[ $root ] = true;
            }
        }
        continue;
    }

    $tokens = @token_get_all( $source );
    $count  = count( $tokens );

    for ( $i = 0; $i < $count; $i++ ) {
        $token = $tokens[ $i ];

        if ( ! is_array( $token ) || $token[0] !== T_STRING || $token[1] !== '__' ) {
            continue;
        }

        /*
         * `__` `(` '<literal>' — with WHITESPACE allowed between every part.
         * The project's own style is `__( 'key' )`, spaces inside the parens
         * (`.claude/rules/code-style.md`), so a walk that assumed adjacency
         * matched only the tight form and counted 137 calls where the tree has
         * more than a thousand. The first version of this check did exactly
         * that and reported PASS, which is the shape of defect it exists to
         * catch: a check that proves a property of the subset it happens to
         * see. It is not a hypothetical — every root the tree really uses came
         * out as an "orphan" in the same run, which is what gave it away.
         */
        $skip = static function ( array $tokens, int $from ): int {
            $count = count( $tokens );
            while ( $from < $count && is_array( $tokens[ $from ] ) && $tokens[ $from ][0] === T_WHITESPACE ) {
                $from++;
            }
            return $from;
        };

        $at = $skip( $tokens, $i + 1 );
        if ( ( $tokens[ $at ] ?? null ) !== '(' ) {
            continue;
        }

        $at  = $skip( $tokens, $at + 1 );
        $arg = $tokens[ $at ] ?? null;
        if ( ! is_array( $arg ) || $arg[0] !== T_CONSTANT_ENCAPSED_STRING ) {
            continue;
        }

        // A dot after the literal means the key is assembled at runtime.
        $at = $skip( $tokens, $at + 1 );
        if ( ( $tokens[ $at ] ?? null ) === '.' ) {
            continue;
        }

        $key = trim( $arg[1], "'\"" );
        if ( strpos( $key, '.' ) === false ) {
            continue;
        }

        $callCount++;
        $rootsUsed[ explode( '.', $key )[0] ] = true;

        if ( ! isset( $catalogueKeys[ $key ] ) ) {
            $problems[] = "{$relative}:{$arg[2]} calls '{$key}', which no catalogue defines — "
                . 'it renders as its own key on every install.';
        }
    }
}

keel_report(
    sprintf(
        'every __() key resolves in a catalogue (%d calls across %d files)',
        $callCount,
        count( $sourceFiles )
    ),
    $problems
);

$orphanRoots = array_values( array_diff( array_keys( $catalogueRoots ), array_keys( $rootsUsed ) ) );
sort( $orphanRoots );

keel_warn(
    'every catalogue root has a consumer',
    array_map(
        static fn( string $root ): string => "catalogue root '{$root}' is referenced by no PHP or JS file — "
            . 'either dead translations, or a screen that has not been built yet.',
        $orphanRoots
    )
);

// ─────────────────────────────────────────────────────────────
// Check: no placeholder copy in distributable surfaces.
// ─────────────────────────────────────────────────────────────
// "Distributable" is not a guess: it is whatever `git check-attr export-ignore`
// says ships, which is the same rule that builds the release archive. Bare
// TODO/PLACEHOLDER are deliberately NOT matched — `install.php` ships Spanish
// copy where "TODO" means "all", and a CSS section header reads "CHART
// PLACEHOLDER". A check that cries wolf on correct content gets ignored, which
// is the failure mode this whole slice exists to prevent.

$problems = [];
$tracked  = keel_git( 'ls-files' );

if ( $tracked === null ) {
    echo "  SKIP  no placeholder copy in distributable surfaces (git unavailable)\n";
} else {
    $scannable = [ 'php', 'js', 'css', 'html', 'json', 'txt', 'md', 'sh' ];
    $candidates = [];

    foreach ( $tracked as $file ) {
        if ( str_contains( $file, 'installer/vendor-ai/' )
            || str_contains( $file, 'installer/admin/assets/vendor/' )
            || str_contains( $file, '.min.' )
        ) {
            continue;
        }

        if ( ! in_array( strtolower( pathinfo( $file, PATHINFO_EXTENSION ) ), $scannable, true ) ) {
            continue;
        }

        $candidates[] = $file;
    }

    // One batched check-attr call; per-file would be hundreds of processes.
    //
    // The candidate list goes in through a TEMP FILE rather than a pipe. Writing
    // the whole list to stdin and only then draining stdout is the classic
    // proc_open deadlock: once the OS pipe buffer (typically 64KB) fills, the
    // parent blocks writing while the child blocks writing output nobody is
    // reading. At ~448 paths it stays under the buffer today, so it would not
    // fail — it would start HANGING silently as the repo grows, which is worse
    // than failing. Found by the slice's own code review.
    $attrFile = tempnam( sys_get_temp_dir(), 'keel-attr-' );
    file_put_contents( $attrFile, implode( "\n", $candidates ) );

    $attrOut = shell_exec(
        'git -C ' . escapeshellarg( $repoRoot ) . ' check-attr --stdin export-ignore < '
        . escapeshellarg( $attrFile ) . ' 2>/dev/null'
    );

    unlink( $attrFile );

    $distributable = [];

    foreach ( explode( "\n", (string) $attrOut ) as $attrLine ) {
        if ( ! str_ends_with( $attrLine, ': unspecified' ) ) {
            continue;
        }

        $distributable[] = substr( $attrLine, 0, -strlen( ': export-ignore: unspecified' ) );
    }

    // A check that scanned NOTHING must never report PASS. Without this, a
    // failed check-attr call (git absent, exec disabled, a resource limit)
    // leaves $distributable empty and the summary line reads
    // "PASS ... (0 files)" — indistinguishable from "nothing to flag". That is
    // the exact failure this whole slice exists to prevent, in the slice's own
    // code; its sibling keel_git() already SKIPs loudly for the same reason.
    if ( $candidates !== [] && $distributable === [] ) {
        keel_report( 'no placeholder copy in distributable surfaces', [
            sprintf(
                'git check-attr returned nothing for %d candidate files, so this check scanned '
                    . 'ZERO files. It has not passed — it did not run.',
                count( $candidates )
            ),
        ] );

        $distributable = null;
    }

    $markers = '/(TODO:|TODO\(|@todo|FIXME|XXX:|lorem ipsum)/i';

    foreach ( $distributable ?? [] as $file ) {
        $path = $repoRoot . '/' . $file;

        if ( ! is_file( $path ) ) {
            continue;
        }

        foreach ( explode( "\n", (string) file_get_contents( $path ) ) as $number => $text ) {
            if ( preg_match( $markers, $text, $match ) === 1 ) {
                $problems[] = sprintf(
                    '%s:%d carries placeholder marker "%s".',
                    $file,
                    $number + 1,
                    trim( $match[1] )
                );
            }
        }
    }

    if ( $distributable !== null ) {
        keel_report(
            sprintf(
                'no placeholder copy in distributable surfaces (%d files)',
                count( $distributable )
            ),
            $problems
        );
    }
}

// ─────────────────────────────────────────────────────────────
// Check: changelog entries run oldest → newest.
// ─────────────────────────────────────────────────────────────

$changelogPath = $repoRoot . '/changelog.txt';
$problems      = [];
$entries       = [];

if ( ! is_file( $changelogPath ) ) {
    $problems[] = 'changelog.txt does not exist.';
} else {
    preg_match_all(
        '/^(\d{4})\.(\d{2})\.(\d{2})\s*-\s*version\s+(\S+)/mi',
        (string) file_get_contents( $changelogPath ),
        $matches,
        PREG_SET_ORDER
    );

    foreach ( $matches as $match ) {
        $entries[] = [ 'date' => $match[1] . $match[2] . $match[3], 'version' => $match[4] ];
    }

    for ( $i = 1; $i < count( $entries ); $i++ ) {
        if ( $entries[ $i ]['date'] < $entries[ $i - 1 ]['date'] ) {
            $problems[] = sprintf(
                'version %s (%s) is dated before version %s (%s) above it — the file must run '
                    . 'oldest to newest.',
                $entries[ $i ]['version'],
                $entries[ $i ]['date'],
                $entries[ $i - 1 ]['version'],
                $entries[ $i - 1 ]['date']
            );
        }
    }
}

if ( count( $entries ) < 2 ) {
    // Stated rather than silently passed: with one entry there is no ordering
    // to verify, so this check has never actually run. Klytos's changelog holds
    // a single entry (0.4.0) and the project has not yet established whether it
    // grows oldest-first (Keel §1a) or newest-first (the common convention).
    // The second entry is when that gets decided — not by this script guessing.
    $checks++;
    printf(
        "  PASS  changelog order oldest → newest (%d entry — ordering not yet exercised)\n",
        count( $entries )
    );
} else {
    keel_report(
        sprintf( 'changelog order oldest → newest (%d entries)', count( $entries ) ),
        $problems
    );
}

// ─────────────────────────────────────────────────────────────
// Check: every registered MCP tool has a capability-map entry (NEW-02).
// ─────────────────────────────────────────────────────────────
// The MCP counterpart of the admin-gate check above (D-048). The gate in
// ToolRegistry::call() default-denies any tool with no entry in
// installer/core/mcp/tool-capabilities.php, so a registered tool that nobody
// mapped is silently unreachable in production with no build-time signal —
// exactly the rot the map exists to prevent. This fails the build in BOTH
// directions: a registered tool with no map entry, and a map entry naming a
// tool that does not register (which is how a renamed tool, or one dropped from
// the loader list, is caught).
//
// The registered set is derived from the loader's OWN file list
// (ToolRegistry::registerAllTools()), the authority on which files actually
// register — a file on disk but off the list does not count. integrity-tools.php
// joined that list in slice 3 (D-049), so its 3 tools are now IN scope here and
// must be mapped; the stub above makes klytos_mcp_tool_capabilities() readable
// without booting the app, so this reads the SHIPPED map (the loader's 34 files,
// not the plugin-filtered set) — the right subject for a release gate.

require_once $repoRoot . '/installer/core/mcp/tool-capabilities.php';

$problems  = [];
$toolsDir  = $repoRoot . '/installer/core/mcp/tools';
$registry  = (string) file_get_contents( $repoRoot . '/installer/core/mcp/tool-registry.php' );

// The loader's hardcoded $toolFiles = [ ... ]; list — the authority on which
// files actually register, so a file on disk but off the list does not count.
$loaderFiles = [];
if ( preg_match( '/\$toolFiles\s*=\s*\[(.*?)\];/s', $registry, $listMatch ) === 1 ) {
    preg_match_all( "/'([a-z0-9-]+\\.php)'/", $listMatch[1], $fileMatch );
    $loaderFiles = $fileMatch[1];
}

$registered = [];
foreach ( $loaderFiles as $file ) {
    $path = $toolsDir . '/' . $file;

    if ( ! is_file( $path ) ) {
        continue;
    }

    // The first quoted argument to each ->register( call is the tool name.
    if ( preg_match_all( "/->register\\(\\s*'([a-zA-Z0-9_]+)'/", (string) file_get_contents( $path ), $toolMatch ) ) {
        $registered = array_merge( $registered, $toolMatch[1] );
    }
}

$map = klytos_mcp_tool_capabilities();

// A check that enumerated NOTHING must never PASS (L-016): a broken loader-list
// parse or an empty tools dir would leave $registered empty and this check would
// report "0 tools, all mapped" — green while verifying nothing. The live count
// is 172 (since slice 3 wired in integrity-tools.php); anything far below that
// means the extraction, not the coverage, broke.
if ( count( $registered ) < 100 ) {
    $problems[] = sprintf(
        'only %d registered MCP tools were found by parsing the loader list — the '
            . 'extraction failed, so this check verified nothing rather than passing.',
        count( $registered )
    );
} else {
    foreach ( $registered as $tool ) {
        if ( ! array_key_exists( $tool, $map ) ) {
            $problems[] = "MCP tool '{$tool}' is registered but has no entry in "
                . 'klytos_mcp_tool_capabilities() — it is denied to everyone by default. Map it '
                . 'in installer/core/mcp/tool-capabilities.php.';
        }
    }

    foreach ( array_keys( $map ) as $tool ) {
        if ( ! in_array( $tool, $registered, true ) ) {
            $problems[] = "the capability map names MCP tool '{$tool}', which is not registered by "
                . 'any loaded tool file — remove it or wire its tool in.';
        }
    }
}

keel_report(
    sprintf(
        'every registered MCP tool has a capability-map entry (%d tools)',
        count( $registered )
    ),
    $problems
);

// ─────────────────────────────────────────────────────────────
// WARN: version touchpoints in sync (audit H-01 — Phase 7 owns the fix).
// ─────────────────────────────────────────────────────────────
// docs/03-technical-plan.md §5 records these as being in four-way
// disagreement. sprint-1.md scopes the fix to Phase 7 and this slice to making
// it detectable, so the drift is reported in full on every run and does not
// fail the build.

$touchpoints = [];
$versionFile = $repoRoot . '/installer/VERSION';

if ( is_file( $versionFile ) ) {
    $touchpoints['installer/VERSION (canonical)'] = trim( (string) file_get_contents( $versionFile ) );
}

$readme = is_file( $repoRoot . '/README.md' )
    ? (string) file_get_contents( $repoRoot . '/README.md' )
    : '';

if ( preg_match( '/\*\*Current version:\*\*\s*(\S+)/', $readme, $match ) === 1 ) {
    $touchpoints['README.md (Current version)'] = $match[1];
}

if ( preg_match( '/VERSION\s+#\s*Current version\s*\(([^)]+)\)/', $readme, $match ) === 1 ) {
    $touchpoints['README.md (structure listing)'] = trim( $match[1] );
}

if ( $entries !== [] ) {
    $touchpoints['changelog.txt (newest entry)'] = $entries[ count( $entries ) - 1 ]['version'];
}

$tags = keel_git( 'tag --sort=-v:refname' );

if ( $tags !== null && $tags !== [] ) {
    $touchpoints['newest git tag'] = ltrim( $tags[0], 'v' );
}

$notes  = [];
$values = array_unique( array_values( $touchpoints ) );

if ( count( $values ) > 1 ) {
    foreach ( $touchpoints as $where => $value ) {
        $notes[] = sprintf( '%-32s %s', $where, $value );
    }

    $notes[] = 'audit H-01 — recorded in docs/03-technical-plan.md §5; the fix belongs to Phase 7.';
}

keel_warn(
    sprintf( 'version touchpoints in sync (%d touchpoints)', count( $touchpoints ) ),
    $notes
);

// ─────────────────────────────────────────────────────────────
// WARN: runtime assets survive the release archive (NEW-27).
// ─────────────────────────────────────────────────────────────
// Found while defining "distributable" for the placeholder check above: the
// blanket `*.md export-ignore` strips every file under installer/core/guides/,
// which is a live PRODUCT surface — klytos_list_guides and klytos_get_guide
// read that directory at runtime, and several guides are declared REQUIRED by
// the tools' own descriptions. This is audit H-02's rule reaching further than
// H-02 recorded. Fixing .gitattributes belongs to Phase 7 (H-02); this makes it
// impossible to forget in the meantime.

$notes = [];
$guides = keel_git( 'ls-files installer/core/guides' );

if ( $guides === null ) {
    echo "  SKIP  runtime assets survive the release archive (git unavailable)\n";
} else {
    $stripped = [];

    foreach ( $guides as $guide ) {
        $attr = keel_git( 'check-attr export-ignore ' . escapeshellarg( $guide ) );

        if ( $attr !== null && str_ends_with( $attr[0] ?? '', ': set' ) ) {
            $stripped[] = $guide;
        }
    }

    if ( $stripped !== [] ) {
        $notes[] = sprintf(
            '%d of %d files under installer/core/guides/ are export-ignored, so they do NOT ship.',
            count( $stripped ),
            count( $guides )
        );
        $notes[] = 'klytos_list_guides / klytos_get_guide read that directory at runtime, so on a '
            . 'released install those tools return nothing.';
        $notes[] = 'audit NEW-27 (H-02 family) — the blanket `*.md export-ignore` in .gitattributes; '
            . 'the fix belongs to Phase 7.';
    }

    keel_warn(
        sprintf( 'runtime assets survive the release archive (%d guides)', count( $guides ) ),
        $notes
    );
}

// ─────────────────────────────────────────────────────────────
// Checks 11–15 — Keel v4.0.0 + v5.0.0.
//
// The rule behind all five: documentation and reality drift while both keep
// looking healthy, and prose asks for discipline once per reader while a check
// enforces itself forever. Each of these was a defect found by hand in this
// project at least once; each is now mechanical.
// ─────────────────────────────────────────────────────────────

/**
 * Check 11 — every `[E]` row of the code map actually exists on disk.
 *
 * The code map is a TARGET tree, not an inventory. A tree diagram and a
 * directory listing look identical on the page, which is exactly how a path
 * that was never created gets read as one that exists. `[A]` and `[G]` rows are
 * NOT checked: they are declared absent, and treating them as present is the
 * trap this marker was introduced to close.
 */
{
    $problems = [];
    $planPath = $repoRoot . '/docs/03-technical-plan.md';

    if ( is_readable( $planPath ) ) {
        $plan = (string) file_get_contents( $planPath );

        // Rows look like: | `path`, `path2` | `[E]` | purpose |
        if ( preg_match_all( '/^\|\s*(.+?)\s*\|\s*`\[E\]`\s*\|/m', $plan, $matches ) ) {
            foreach ( $matches[1] as $cell ) {
                if ( preg_match_all( '/`([^`]+)`/', $cell, $paths ) === 0 ) {
                    continue;
                }

                foreach ( $paths[1] as $path ) {
                    // Glob rows (installer/core/*.php) are checked as their directory.
                    $probe = str_contains( $path, '*' ) ? dirname( $path ) : $path;

                    if ( ! file_exists( $repoRoot . '/' . rtrim( $probe, '/' ) ) ) {
                        $problems[] = sprintf(
                            'code map marks `%s` as [E] (exists on disk) and it does not exist.',
                            $path
                        );
                    }
                }
            }
        }
    } else {
        $problems[] = 'docs/03-technical-plan.md is not readable — the code map cannot be verified.';
    }

    keel_report( 'code map: every [E] path exists on disk', $problems );
}

/**
 * Check 12 — every internal Markdown link resolves.
 *
 * A broken link in the repository's own front door is the cheapest possible
 * defect to find and one nobody finds by reading, because a link only fails
 * when someone clicks it. Found by hand on 2026-07-28: ten dead links in
 * README.md alone.
 */
{
    $problems = [];
    $targets  = [ 'README.md', 'CLAUDE.md', 'AGENTS.md' ];

    $docs = glob( $repoRoot . '/docs/*.md' ) ?: [];
    foreach ( $docs as $doc ) {
        $targets[] = 'docs/' . basename( $doc );
    }

    foreach ( $targets as $relative ) {
        $full = $repoRoot . '/' . $relative;

        if ( ! is_readable( $full ) ) {
            continue;
        }

        $body = (string) file_get_contents( $full );

        if ( preg_match_all( '/\]\(([^)\s#]+\.md)(?:#[^)]*)?\)/', $body, $links ) === 0 ) {
            continue;
        }

        foreach ( array_unique( $links[1] ) as $link ) {
            if ( str_starts_with( $link, 'http' ) ) {
                continue;
            }

            $resolved = $repoRoot . '/' . ltrim( dirname( $relative ) === '.' ? $link : dirname( $relative ) . '/' . $link, '/' );

            if ( ! file_exists( $resolved ) && ! file_exists( $repoRoot . '/' . ltrim( $link, '/' ) ) ) {
                $problems[] = sprintf( '%s links to %s, which does not exist.', $relative, $link );
            }
        }
    }

    // Baseline-locked, exactly like the lint baseline (D-025), and for the same
    // reason: these ten predate the check, they are all in README.md, and the
    // editorial pass that owns them is already recorded (D-017 — the same pass
    // that owns the stale per-module tool table). Locking them is NOT the gate
    // being loosened to get green: a NEW broken link FAILS, so the number can
    // only go down. Unlocking happens when D-017's pass runs.
    $knownBroken = [
        'README.md -> docs/KLYTOS-ARCHITECTURE-V2.md',
        'README.md -> docs/KLYTOS-HOOKS-API.md',
        'README.md -> docs/KLYTOS-TEMPLATE-SYSTEM.md',
        'README.md -> docs/PLUGINS-ARCHITECTURE.md',
        'README.md -> docs/PLUGINS-ADMIN-UI.md',
        'README.md -> docs/TEMPLATES-ARCHITECTURE.md',
        'README.md -> docs/TERMINAL-ARCHITECTURE.md',
        'README.md -> docs/DEVELOPER-MODE.md',
        'README.md -> docs/consent-manager-spec.md',
        'README.md -> docs/KLYTOS-X402.md',
    ];

    $newProblems = [];
    $baselined   = [];

    foreach ( $problems as $problem ) {
        // Problems are phrased "<file> links to <target>, which does not exist."
        if ( preg_match( '/^(\S+) links to (\S+),/', $problem, $m ) === 1
            && in_array( $m[1] . ' -> ' . $m[2], $knownBroken, true )
        ) {
            $baselined[] = $problem;
            continue;
        }

        $newProblems[] = $problem;
    }

    keel_report( 'internal documentation links resolve (no NEW broken link)', $newProblems );

    keel_warn(
        sprintf( 'README.md link backlog (%d known broken, baseline-locked)', count( $baselined ) ),
        $baselined === [] ? [] : array_merge(
            $baselined,
            [ 'These ten are the repository front door pointing at documents that do not exist, in a '
                . 'public repo. Owned by the D-017 README editorial pass, with the stale tool table. '
                . 'The baseline may only shrink.' ]
        )
    );
}

/**
 * Check 13 — every command cited in the docs exists as a real file.
 *
 * Trap 1 in references/anti-patterns.md: the declared tool that never runs. A
 * command named in a document is a promise to the reader, and a promise to a
 * reader is exactly the kind of thing that rots silently.
 */
{
    $problems = [];
    $cited    = [
        'scripts/keel-verify',
        'scripts/keel-doctor',
        'scripts/dev/seed-playground.php',
        'scripts/dev/router.php',
        'scripts/dev/upgrade-test.sh',
        'phpcs.xml',
        '.github/workflows/ci.yml',
    ];

    foreach ( $cited as $path ) {
        if ( ! file_exists( $repoRoot . '/' . $path ) ) {
            $problems[] = sprintf( '%s is cited in the docs and does not exist.', $path );
        }
    }

    keel_report( 'every cited command exists', $problems );
}

/**
 * Check 14 — the conformance sweep has no unexplained gap.
 *
 * Keel v5.0.0, "Applying Keel completely": a project may not be reported as
 * reconciled or released with a requirement that is neither applied, nor
 * declined on the record, nor excluded by a stated condition. This is a WARN
 * rather than a FAIL while Phase 6, 7 and 8 rows are legitimately ahead of the
 * project's position — a fact the file itself states per row.
 */
{
    $notes    = [];
    $sweep    = $repoRoot . '/docs/keel-conformance.md';

    if ( ! is_readable( $sweep ) ) {
        $notes[] = 'docs/keel-conformance.md does not exist — the sweep has never been run.';
    } else {
        $body    = (string) file_get_contents( $sweep );
        $missing = 0;

        // Count STATE CELLS, not occurrences of the word. The first version of
        // this check ran preg_match_all over the whole file, so the legend line
        // defining the four states and any sentence discussing the result each
        // inflated the total by one — and the number it printed could not be
        // reconciled with the table it claimed to summarise. Found 2026-08-09
        // (D-087) by writing a sweep with two missing rows and being told four.
        foreach ( explode( "\n", $body ) as $line ) {
            $line = trim( $line );

            if ( $line === '' || $line[0] !== '|' ) {
                continue;
            }

            foreach ( keel_table_cells( $line ) as $cell ) {
                if ( $cell === '**missing**' ) {
                    $missing++;
                }
            }
        }

        if ( $missing > 0 ) {
            $notes[] = sprintf(
                '%d requirement(s) are still marked **missing** in docs/keel-conformance.md.',
                $missing
            );
            $notes[] = 'Each must become present, declined with its decision entry, or n/a with its '
                . 'condition. Rows belonging to a phase this project has not reached yet are '
                . 'legitimately ahead — which is why this warns rather than fails.';
        }
    }

    keel_warn( 'conformance sweep has no unexplained gap', $notes );
}

/**
 * Check 15 — report the suppression count in FIRST-PARTY code.
 *
 * Never a failure: suppressions are legitimate. But the count may only fall
 * deliberately, and it cannot fall deliberately if nobody knows what it is.
 *
 * Measured for the first time on 2026-07-28, and the first measurement was
 * WRONG in the informative direction: a naive grep over `installer/` returned
 * 119 and was read as this project's debt. All 119 are in
 * `installer/vendor-ai/` — third-party vendored code Klytos does not author and
 * may not edit. **Klytos's own first-party count is 0.** The two measurements
 * disagreeing is what surfaced it (L-023), which is why the exclusion below is
 * load-bearing rather than tidy: counting vendored suppressions would set a
 * baseline of 119 that no Klytos change could ever move, training everyone to
 * ignore the number.
 *
 * Baseline: 0. It may only grow deliberately.
 */
{
    $count    = 0;
    $patterns = [ 'phpcs:ignore', 'phpcs:disable', '@phpstan-ignore', 'codingStandardsIgnore' ];

    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator( $repoRoot . '/installer', FilesystemIterator::SKIP_DOTS )
    );

    foreach ( $iterator as $file ) {
        if ( ! $file->isFile() || $file->getExtension() !== 'php' ) {
            continue;
        }

        if ( str_contains( $file->getPathname(), '/vendor-ai/' ) ) {
            continue;
        }

        $body = (string) file_get_contents( $file->getPathname() );

        foreach ( $patterns as $pattern ) {
            $count += substr_count( $body, $pattern );
        }
    }

    keel_warn(
        sprintf( 'first-party lint/analysis suppressions (installer/, excluding vendor-ai): %d', $count ),
        $count > 0
            ? [ sprintf( 'the recorded baseline is 0; this run counts %d. A suppression is legitimate, '
                . 'but it is added deliberately, with a written reason, or not at all.', $count ) ]
            : []
    );
}

/*
 * Check 16 — every `#ks-*` the admin references resolves to a real `<symbol>`.
 *
 * Added 2026-07-29 as part of DR-003's resolution (D-074, L-030), and the
 * timing is the point: it is added BEFORE the first `<use>` is written, not
 * after someone screenshots an empty box.
 *
 * A broken cross-document `<use href="…#ks-name">` is not an error. The browser
 * renders NOTHING — no console message, no failed request, no visual cue beyond
 * a gap where an icon should be. It is the quietest possible defect, and the
 * Phase 4 gate could not see it: the gate proved the sprite existed, was
 * described by `SPEC/assets-index.md` and was byte-identical to the delivery —
 * all true, and none of them the question that mattered, which is whether the
 * glyph a screen DRAWS is one of the symbols the sprite CONTAINS. That gap cost
 * a Design Request (19 of the sidebar's 35 nav glyphs had no symbol) and it is
 * closed here mechanically instead of by remembering to look.
 *
 * On a tree with no `<use>` yet this PASSES on zero references. That is not a
 * weakness of the check; it is the check waiting correctly. The first typo'd or
 * hopeful id fails it.
 *
 * FAIL, not WARN: nobody owns this elsewhere, and the fix is always local — add
 * the symbol to the sprite in the delivered geometry, or correct the id.
 */
{
    $problems = [];
    $sprite   = $repoRoot . '/installer/admin/assets/icons/klytos-ui-icons.svg';

    if ( ! is_file( $sprite ) ) {
        $problems[] = 'the icon sprite is missing at installer/admin/assets/icons/klytos-ui-icons.svg';
    } else {
        $known = [];
        preg_match_all( '/<symbol[^>]+id="(ks-[A-Za-z0-9_-]+)"/', (string) file_get_contents( $sprite ), $ids );
        foreach ( $ids[1] as $id ) {
            $known[ $id ] = true;
        }

        $referenced = [];
        $files      = [];

        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator( $repoRoot . '/installer/admin', FilesystemIterator::SKIP_DOTS )
        );
        foreach ( $iterator as $file ) {
            if ( ! $file->isFile() || ! in_array( $file->getExtension(), [ 'php', 'html', 'js', 'css' ], true ) ) {
                continue;
            }
            // The sprite itself defines the ids; it does not reference them.
            if ( str_contains( $file->getPathname(), '/assets/icons/' ) ) {
                continue;
            }
            $files[] = $file->getPathname();
        }

        // The primary-navigation model names 30+ glyphs and lives in core/, not
        // admin/. Scanning only admin/ made this check pass on ZERO references
        // while the sidebar drew a full set of icons — the check measuring
        // nothing and reporting green, which is the very failure L-030 records.
        // Found 2026-07-29 by reading the check's own "0 distinct id(s)" line
        // against a shell that plainly had icons in it.
        $files[] = $repoRoot . '/installer/core/admin-nav.php';

        foreach ( $files as $path ) {
            if ( ! is_file( $path ) ) {
                continue;
            }

            $source = (string) file_get_contents( $path );

            // Two shapes, because the id reaches the browser two ways: written
            // literally into markup (`<use href="…#ks-name">`), or carried as a
            // PHP/JS string that a helper interpolates into that same markup.
            // Only matching the first would miss every icon drawn from data.
            preg_match_all( '/#(ks-[A-Za-z0-9_-]+)/', $source, $hashUses );
            preg_match_all( '/[\'"](ks-[A-Za-z0-9_-]+)[\'"]/', $source, $quotedUses );

            foreach ( array_merge( $hashUses[1], $quotedUses[1] ) as $id ) {
                $referenced[ $id ][] = str_replace( $repoRoot . '/', '', $path );
            }
        }

        foreach ( $referenced as $id => $files ) {
            if ( isset( $known[ $id ] ) ) {
                continue;
            }

            $problems[] = sprintf(
                '%s is referenced in %s but no <symbol id="%s"> exists in the sprite — '
                    . 'this renders nothing, silently, with no console error',
                $id,
                implode( ', ', array_unique( $files ) ),
                $id
            );
        }

        if ( $problems === [] ) {
            printf(
                "  ....  icon sprite: %d symbol(s), %d distinct id(s) referenced, all resolving\n",
                count( $known ),
                count( $referenced )
            );
        }
    }

    keel_report( 'every #ks-* the admin references resolves to a sprite <symbol>', $problems );
}

/**
 * Checks 18, 19 and 20 — the test-first policy was actually applied.
 *
 * Keel v5.11.0. The card says `Test-first policy: pure-logic`, and a policy
 * nobody records is a policy nobody applied — so every test-point row carries a
 * `Red first` cell holding one of five fixed values, and these three checks are
 * what stop that column becoming decoration.
 *
 * The asymmetry between them is deliberate and is the whole design:
 *
 *   18 (FAIL)   the cell is one of the five values. A closed enum for the same
 *               reason `Coverage` has one: a script can only count what it can
 *               recognise, and free text counts as nothing.
 *   19 (FAIL)   a row claiming `observed` carries the failure line it claims to
 *               have seen, introduced by the literal phrase `red observed:` and
 *               quoted in backticks. A claim with no evidence is the one thing
 *               this project does not accept anywhere else either.
 *   20 (REPORT) every row that is neither `observed` nor `n/a — delegated` is
 *               listed for a person to judge, and never fails the run. The
 *               script cannot decide whether a given piece of code is pure
 *               logic; if the judgment-bearing values were invisible, the
 *               mildest one would quietly become the default.
 *
 * Scope: a table in docs/05-test-points.md is a test-point table when its first
 * column is `Slice` or `Stage`. The file's other tables — the two legends, the
 * session-start freshness log, the cross-cutting checklist — are not test-point
 * rows and are deliberately out of scope rather than silently skipped.
 */
{
    $redValues = [
        'observed',
        'n/a — policy',
        'n/a — out of scope',
        'n/a — predates',
        'n/a — delegated',
    ];

    $enumProblems = [];
    $redProblems  = [];
    $judgment     = [];
    $rowsSeen     = 0;

    $pointsPath = $repoRoot . '/docs/05-test-points.md';

    if ( ! is_readable( $pointsPath ) ) {
        $enumProblems[] = 'docs/05-test-points.md does not exist — the test-point log is '
            . 'unconditional from Phase 5 onward.';
    } else {
        $lines  = explode( "\n", (string) file_get_contents( $pointsPath ) );
        $header = null;
        $redCol = -1;
        $evCol  = -1;

        foreach ( $lines as $index => $rawLine ) {
            $line   = trim( $rawLine );
            $lineNo = $index + 1;

            if ( $line === '' || $line[0] !== '|' ) {
                $header = null;
                continue;
            }

            // The separator row carries no data and no header.
            if ( preg_match( '/^\|[\s:|-]+\|$/', $line ) === 1 ) {
                continue;
            }

            $cells = keel_table_cells( $line );

            if ( $header === null ) {
                if ( ! in_array( $cells[0], [ 'Slice', 'Stage' ], true ) ) {
                    continue;
                }

                $header = $cells;
                $redKey = array_search( 'Red first', $cells, true );
                $redCol = $redKey === false ? -1 : (int) $redKey;
                $evCol  = -1;

                foreach ( $cells as $column => $name ) {
                    if ( str_contains( $name, 'Evidence' ) ) {
                        $evCol = (int) $column;
                        break;
                    }
                }

                if ( $redCol === -1 ) {
                    $enumProblems[] = sprintf(
                        'docs/05-test-points.md:%d — this test-point table has no `Red first` '
                            . 'column. Every test-point row carries one (Keel v5.11.0).',
                        $lineNo
                    );
                    $header = null;
                }

                continue;
            }

            if ( count( $cells ) !== count( $header ) ) {
                $enumProblems[] = sprintf(
                    'docs/05-test-points.md:%d — the row has %d cells and its header has %d. '
                        . 'An unescaped `|` inside a cell splits the row and moves every value '
                        . 'after it into the wrong column.',
                    $lineNo,
                    count( $cells ),
                    count( $header )
                );
                continue;
            }

            $rowsSeen++;
            $red   = $cells[ $redCol ];
            $label = mb_substr( strip_tags( str_replace( '**', '', $cells[0] ) ), 0, 60 );

            if ( ! in_array( $red, $redValues, true ) ) {
                $enumProblems[] = sprintf(
                    'docs/05-test-points.md:%d (%s) — `Red first` is "%s"; it must be exactly one '
                        . 'of: %s.',
                    $lineNo,
                    $label,
                    $red === '' ? '(empty)' : $red,
                    implode( ' · ', $redValues )
                );
                continue;
            }

            if ( $red === 'observed' ) {
                $evidence = $evCol === -1 ? '' : $cells[ $evCol ];

                if ( preg_match( '/red observed:[^`]{0,160}`[^`]+`/u', $evidence ) !== 1 ) {
                    $redProblems[] = sprintf(
                        'docs/05-test-points.md:%d (%s) — claims `observed` with no failure line '
                            . 'beside it. The evidence cell must carry the phrase "red observed:" '
                            . 'followed by the failure quoted in backticks.',
                        $lineNo,
                        $label
                    );
                }
            }

            if ( $red !== 'observed' && $red !== 'n/a — delegated' ) {
                $judgment[] = sprintf( 'docs/05-test-points.md:%d (%s) — %s', $lineNo, $label, $red );
            }
        }
    }

    if ( $enumProblems === [] && $redProblems === [] ) {
        printf( "  ....  test points: %d row(s) carry a recognised `Red first` value\n", $rowsSeen );
    }

    keel_report( '`Red first` holds one of its five values in every test-point row', $enumProblems );
    keel_report( 'every `observed` row carries the failure line it claims to have seen', $redProblems );

    if ( $judgment !== [] ) {
        $judgment[] = 'Reported, never failed: the card says `Test-first policy: pure-logic`, and '
            . 'whether a given row is pure logic is a judgment no script can make. These rows are '
            . 'listed at the sprint close for a person to judge.';
    }

    keel_warn( 'test-first: rows carrying a judgment a person must make', $judgment );
}

/*
 * Check 21 — a `k-*` component that sets `display` still hides when `hidden`.
 *
 * Added 2026-08-10 (D-091), and the reason it is a check rather than a comment
 * is that the comment already existed and has now been forgotten FIVE times.
 *
 * The mechanism is always the same. `[hidden] { display: none }` lives in the
 * user-agent stylesheet at specificity (0,1,0). A component rule like
 * `.k-field { display: flex }` is also (0,1,0) — and an author stylesheet beats
 * the UA on ORIGIN, whatever the order. So the element keeps its `hidden`
 * attribute, keeps being reported as hidden by every reading of the DOM, and is
 * painted on the screen and operable with the mouse and the keyboard. Assistive
 * technology and the browser disagree about whether it exists.
 *
 * It has arrived as: the bulk bar visible on load (D-079), the Logs payload
 * copy button (D-085), and the Security screen's passkey enrolment form, which
 * appeared in browsers with no WebAuthn at all — a control that cannot do the
 * only thing it exists for. Every one of them was found by driving, never by
 * reading, because the source says `hidden` and looks right.
 *
 * What it checks: every element in the admin's own markup that carries a bare
 * `hidden` attribute and a `k-*` class, against the component stylesheets. If
 * that class declares a `display` other than `none`, a `.class[hidden]` rule
 * must exist. Deliberately narrow — markup only, single-class rules only —
 * because a check that guesses is a check nobody trusts.
 *
 * FAIL, not WARN: nobody owns this elsewhere and the fix is one rule.
 */
{
    $problems = [];

    $sheets = [
        'installer/admin/assets/css/klytos-components.css',
        'installer/admin/assets/css/klytos-shell.css',
    ];

    /** @var array<string,string> class => the display value it declares */
    $displays = [];
    /** @var array<string,bool> class => it has its own [hidden] rule */
    $guarded = [];

    foreach ( $sheets as $relative ) {
        $path = $repoRoot . '/' . $relative;
        if ( ! is_file( $path ) ) {
            $problems[] = $relative . ' is missing — the component layer cannot be checked';
            continue;
        }

        $css = (string) file_get_contents( $path );

        // Single-class rules only: `.k-foo { … display: X … }`. A compound or
        // descendant selector is skipped rather than guessed at.
        preg_match_all( '/(^|\})\s*\.(k-[a-z0-9-]+)\s*\{([^}]*)\}/m', $css, $rules, PREG_SET_ORDER );
        foreach ( $rules as $rule ) {
            if ( preg_match( '/(^|;)\s*display\s*:\s*([a-z-]+)/', $rule[3], $display ) ) {
                if ( $display[2] !== 'none' ) {
                    $displays[ $rule[2] ] = $display[2];
                }
            }
        }

        preg_match_all( '/\.(k-[a-z0-9-]+)\[hidden\]/', $css, $hidden );
        foreach ( $hidden[1] as $class ) {
            $guarded[ $class ] = true;
        }
    }

    /** Every admin source that can emit markup. */
    $sources = [];
    $adminDir = $repoRoot . '/installer/admin';
    if ( is_dir( $adminDir ) ) {
        $iterator = new RecursiveIteratorIterator( new RecursiveDirectoryIterator( $adminDir ) );
        foreach ( $iterator as $file ) {
            $path = $file->getPathname();
            if ( substr( $path, -4 ) === '.php' && strpos( $path, '/assets/vendor/' ) === false ) {
                $sources[] = $path;
            }
        }
    }
    sort( $sources );

    foreach ( $sources as $path ) {
        $markup = (string) file_get_contents( $path );

        /*
         * Any start tag carrying a BARE `hidden` attribute.
         *
         * `\bhidden\b` is wrong here and the first run proved it: `-` is a word
         * boundary, so it matches the `hidden` inside `aria-hidden="true"` and
         * reported the sidebar's avatar — an element that is correctly visible
         * and correctly hidden from the accessibility tree. The lookbehind is
         * what separates the attribute from every `*-hidden` attribute name.
         */
        preg_match_all( '/<[a-z][^>]*?(?<![-\w])hidden(?=[\s>])[^>]*>/is', $markup, $tags );
        foreach ( $tags[0] as $tag ) {
            if ( ! preg_match( '/class="([^"]*)"/i', $tag, $classAttr ) ) {
                continue;
            }
            foreach ( preg_split( '/\s+/', $classAttr[1] ) as $class ) {
                if ( ! isset( $displays[ $class ] ) || isset( $guarded[ $class ] ) ) {
                    continue;
                }
                $problems[] = sprintf(
                    '%s renders .%s with the `hidden` attribute, but that class declares '
                    . '`display: %s` and has no `.%s[hidden] { display: none }` rule — '
                    . 'the element stays PAINTED while the DOM says it is hidden',
                    str_replace( $repoRoot . '/', '', $path ),
                    $class,
                    $displays[ $class ],
                    $class
                );
            }
        }
    }

    keel_report( 'a hidden `k-*` component actually hides', array_values( array_unique( $problems ) ) );
}

// ─────────────────────────────────────────────────────────────

echo "\n";

if ( $failures !== [] ) {
    printf(
        "FAILED — %d problem(s) across %d check(s).\n",
        count( $failures ),
        $checks
    );
    exit( 1 );
}

// The summary reports what was OBSERVED, not a total dressed up as a result.
// It used to print "%d check(s) passed" with the TOTAL, counting the two WARN
// checks as passes and then reporting them again as warnings — so a reader who
// counted the PASS lines found 8 where the summary claimed 10. Found by a
// fresh-context pass following docs/playground.md, which quotes this line as
// expected output. A verifier that miscounts its own result is the L-016 defect
// in the script written to prevent it.
if ( $warnings !== [] ) {
    printf(
        "OK — %d check(s) run: %d passed, %d warning(s) carrying %d note(s) (owned by another phase).\n",
        $checks,
        $checks - $warnedChecks,
        $warnedChecks,
        count( $warnings )
    );
    exit( 0 );
}

printf( "OK — %d check(s) run: all passed.\n", $checks );
exit( 0 );
