# ─── Git Attributes ───────────────────────────────────────────
# Controls what gets included in GitHub release archives (ZIP/tar.gz).
# Files marked with `export-ignore` are excluded from `git archive`
# and GitHub's "Download ZIP" / release asset generation.

# ─── Documentation (not needed in production) ────────────────
docs/                       export-ignore
*.md                        export-ignore
LICENSE                     -export-ignore
PRIVACY.md                  -export-ignore

# ─── Development Files ───────────────────────────────────────
.github/                    export-ignore
.claude/                    export-ignore
tests/                      export-ignore
phpunit.xml                 export-ignore
phpstan.neon                export-ignore
composer.json               export-ignore
composer.lock               export-ignore
package.json                export-ignore
package-lock.json           export-ignore
playwright.config.js        export-ignore
node_modules/               export-ignore
phpcs.xml                   export-ignore
.editorconfig               export-ignore
.gitignore                  export-ignore
.gitattributes              export-ignore

# ─── IDE / Config ────────────────────────────────────────────
.idea/                      export-ignore
.vscode/                    export-ignore

# ─── Normalize Line Endings ──────────────────────────────────
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# ─── Binary Files (don't diff) ──────────────────────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.tar.gz binary
# ─── Keel: workflow & assistant config — never in the distributable ──
# Nothing from the Keel package ships. Covers every accepted assistant's
# container (D-010), the embedded skill trees, the lock files and the gate.
CLAUDE.md                   export-ignore
AGENTS.md                   export-ignore
.agents/                    export-ignore
.codex/                     export-ignore
.cursor/                    export-ignore
.gemini/                    export-ignore
.windsurf/                  export-ignore
.githooks/                  export-ignore
.mcp.json                   export-ignore
.keel-update-check          export-ignore
installer/core/AGENTS.md    export-ignore
installer/admin/AGENTS.md   export-ignore
installer/plugins/AGENTS.md export-ignore
